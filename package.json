{
  "name": "web-aerovantia",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "deploy": "astro build && node scripts/check-pending.mjs && wrangler deploy",
    "check:pendientes": "node scripts/check-pending.mjs",
    "report:precios": "node scripts/report-precios.mjs",
    "deploy:preview": "astro build && wrangler deploy --name web-aerovantia-preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.1",
    "lenis": "^1.3.27"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
