---
import { company, legal, services } from "../data/site";
---

<footer>
  <div class="wrap">
    <div>
      <a class="logo" href="/">AEROVANTIA<span>.</span></a>
      <p style="margin-top:10px;max-width:42ch">
        Reformas, obra nueva, interiorismo, aerotermia y placas solares en Toledo y el sur de Madrid desde {company.foundedYear}.
      </p>
      <p style="margin-top:10px">
        {company.phones.map((p, i) => <>{i > 0 && " · "}<a href={`tel:${p.tel}`}>{p.display}</a></>)}<br />
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>
      <p style="margin-top:10px;font-size:.8rem">{company.name} es una marca de {company.legalName} · NIF {company.cif} · {company.address}</p>
    </div>
    <div>
      <strong>Servicios</strong>
      <ul>{services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
    </div>
    <div>
      <strong>Aerovantia</strong>
      <ul>
        <li><a href="/#calculadoras">Calculadoras</a></li>
        <li><a href="/#ayudas">Ayudas y subvenciones</a></li>
        <li><a href="/#zona">Zona de trabajo</a></li>
        <li><a href="/#contacto">Contacto</a></li>
      </ul>
    </div>
    <div>
      <strong>Legal</strong>
      <ul>{legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>
