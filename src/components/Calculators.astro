---
// Calculadoras de aerotermia, placas solares y reformas, con el presupuesto orientativo.
// La portada las muestra todas; /calculadoras/… muestran una sola (prop `only`).
// Lógica en src/scripts/calc.js; precios en src/data/prices.json; hipótesis en src/data/energy.json.
import prices from "../data/prices.json";

interface Props {
  only?: "aero" | "solar" | "ref" | ("aero" | "solar" | "ref")[];
  /** Zona preseleccionada (landings de municipio). */
  zone?: "madrid" | "toledo";
}

const { only, zone = "madrid" } = Astro.props;
const tabs = [
  { k: "aero", label: "Aerotermia" },
  { k: "solar", label: "Placas solares" },
  { k: "ref", label: "Reformas" },
].filter((t) => !only || (Array.isArray(only) ? only.includes(t.k as any) : t.k === only));
const first = tabs[0].k;
const show = (k: string) => tabs.some((t) => t.k === k);
const zoneOptions = [
  { v: "madrid", label: "Comunidad de Madrid" },
  { v: "toledo", label: "Provincia de Toledo" },
];
---

<div data-calcs data-zone={zone}>
  {tabs.length > 1 && (
    <div class="tabs" role="tablist">
      {tabs.map((t) => (
        <button class="tab" role="tab" id={`t-${t.k}`} data-k={t.k} aria-selected={t.k === first ? "true" : "false"} aria-controls={`p-${t.k}`}>{t.label}</button>
      ))}
    </div>
  )}

  {show("aero") && (
    <div class="calc-grid" role="tabpanel" id="p-aero" aria-labelledby={tabs.length > 1 ? "t-aero" : undefined} hidden={first !== "aero"}>
      <form class="fields" onsubmit="return false">
        <div class="field"><label for="a-fuel">Sistema actual</label>
          <select id="a-fuel"><option value="gasoleo" selected>Caldera de gasóleo</option><option value="propano">Caldera de propano</option><option value="gas">Caldera de gas natural</option><option value="elec">Radiadores o acumuladores eléctricos</option></select></div>
        <div class="field" id="a-boiler-f"><label for="a-boiler">Tipo de caldera</label>
          <select id="a-boiler"><option value="estandar" selected>Estándar o de más de 15 años (o no lo sé)</option><option value="bajaTemperatura">Baja temperatura</option><option value="condensacion">Condensación</option></select></div>
        <div class="field"><label for="a-spend">Gasto anual en calefacción y agua caliente: <span class="range-val" id="a-spend-v"></span></label>
          <input type="range" id="a-spend" min="800" max="6000" step="100" value="2400"><small>Suma de facturas o llenados de depósito de 12 meses.</small></div>
        <div class="field"><label for="a-m2">Superficie calefactada: <span class="range-val" id="a-m2-v"></span></label>
          <input type="range" id="a-m2" min="60" max="450" step="10" value="180"></div>
        <div class="field"><label for="a-ins">Aislamiento de la casa</label>
          <select id="a-ins"><option value="good">Bueno (construida después de 2007 o rehabilitada)</option><option value="mid" selected>Medio (1980–2007, ventanas de doble cristal)</option><option value="poor">Bajo (antes de 1980, sin aislar)</option></select></div>
        <div class="field"><label for="a-emit">Cómo se reparte el calor</label>
          <select id="a-emit"><option value="keep" selected>Mantengo mis radiadores</option><option value="radiators">Radiadores nuevos de baja temperatura</option><option value="floor">Suelo radiante nuevo</option></select></div>
        <div class="field"><label for="a-zone">Zona</label>
          <select id="a-zone">{zoneOptions.map((o) => <option value={o.v} selected={o.v === zone}>{o.label}</option>)}</select></div>
        <label class="chk" for="a-irpf"><input type="checkbox" id="a-irpf" checked> Vivienda habitual o alquilada (deducción IRPF del 40&nbsp;%, si tu caso cumple los requisitos)</label>
      </form>
      <div class="result" aria-live="polite">
        <div><p class="eyebrow">Inversión orientativa · IVA incluido</p><div class="big" id="a-from">—</div><p class="range-line" id="a-range"></p></div>
        <div class="compare">
          <div class="cbar"><span>Gasto hoy</span><div class="track"><div class="fill" id="a-b1" style="background:var(--warm)"></div></div><span class="n" id="a-n1"></span></div>
          <div class="cbar"><span>Aerotermia</span><div class="track"><div class="fill" id="a-b2" style="background:var(--cold)"></div></div><span class="n" id="a-n2"></span></div>
        </div>
        <div class="res-rows">
          <div><span>Bomba de calor recomendada</span><b id="a-kw"></b></div>
          <div><span>Ahorro estimado al año</span><b id="a-save"></b></div>
          <div><span>Deducción IRPF, si cumples los requisitos</span><b id="a-irpf-v"></b></div>
          <div><span>Retorno de la inversión</span><b id="a-ret"></b></div>
        </div>
        <p class="calc-note" id="a-warn" hidden></p>
        <details><summary>Ver hipótesis</summary><ul class="q-notes" id="a-hyp"></ul></details>
        <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="aero">Ver mi presupuesto</button><a class="btn btn-ghost" href="/#contacto" data-from="aero">Reservar visita gratis</a></div>
      </div>
    </div>
  )}

  {show("solar") && (
    <div class="calc-grid" role="tabpanel" id="p-solar" aria-labelledby={tabs.length > 1 ? "t-solar" : undefined} hidden={first !== "solar"}>
      <form class="fields" onsubmit="return false">
        <div class="field"><label for="s-bill">Factura de luz media al mes: <span class="range-val" id="s-bill-v"></span></label>
          <input type="range" id="s-bill" min="40" max="450" step="5" value="120"></div>
        <div class="field"><label for="s-zone">Zona</label>
          <select id="s-zone">{zoneOptions.map((o) => <option value={o.v} selected={o.v === zone}>{o.label}</option>)}</select></div>
        <div class="field"><label for="s-profile">¿Cuándo usáis más la luz?</label>
          <select id="s-profile"><option value="dia" selected>Hay alguien en casa durante el día</option><option value="fuera">Casi todo el consumo es por la tarde y la noche</option></select></div>
        <div class="field"><label for="s-type">Tipo de cubierta</label>
          <select id="s-type"><option value="teja" selected>Tejado de teja</option><option value="chapa">Chapa o panel sándwich</option><option value="pizarra">Pizarra</option><option value="plana">Cubierta plana o azotea</option><option value="uralita">Fibrocemento (uralita)</option></select></div>
        <div class="field" id="s-orient-f"><label for="s-orient">Orientación del tejado</label>
          <select id="s-orient"><option value="S" selected>Sur</option><option value="SE">Sureste</option><option value="SO">Suroeste</option><option value="EO">Este-oeste (tejado a dos aguas)</option><option value="E">Este</option><option value="O">Oeste</option><option value="NE">Noreste</option><option value="NO">Noroeste</option><option value="N">Norte</option></select>
          <small>Hacia dónde mira la parte del tejado donde irían los paneles.</small></div>
        <fieldset class="field" id="s-tilt-f"><legend>Inclinación del tejado</legend>
          <div class="seg">
            <label><input type="radio" name="s-tilt" value="15"> Suave (≈15°)</label>
            <label><input type="radio" name="s-tilt" value="30" checked> Normal (≈30°)</label>
            <label><input type="radio" name="s-tilt" value="45"> Pronunciada (≈45°)</label>
          </div></fieldset>
        <div class="field"><label for="s-shade">Sombras sobre el tejado</label>
          <select id="s-shade"><option value="none" selected>Sin sombras</option><option value="some">Algunas (chimenea, árbol, a primera o última hora)</option><option value="lot">Bastantes (edificios o árboles altos cerca)</option></select></div>
        <div class="field"><label for="s-area">Superficie útil para paneles: <span class="range-val" id="s-area-v"></span></label>
          <input type="range" id="s-area" min="10" max="150" step="5" value="50"><small>Sin contar chimeneas, claraboyas ni bordes.</small></div>
        <div class="field"><label for="s-bat">Batería</label>
          <select id="s-bat"><option value="0">Sin batería</option><option value="5" selected>5 kWh</option><option value="10">10 kWh</option></select></div>
        <label class="chk" for="s-aero"><input type="checkbox" id="s-aero"> También instalo aerotermia (sube el consumo eléctrico)</label>
        <label class="chk" for="s-ev"><input type="checkbox" id="s-ev"> Añadir cargador para coche eléctrico</label>
        <label class="chk" for="s-irpf"><input type="checkbox" id="s-irpf"> Vivienda habitual o alquilada (deducción IRPF del 40&nbsp;%, si tu caso cumple los requisitos)</label>
      </form>
      <div class="result" aria-live="polite">
        <div><p class="eyebrow">Inversión orientativa · IVA incluido</p><div class="big" id="s-from" style="color:#B7861B">—</div><p class="range-line" id="s-range"></p></div>
        <div class="compare">
          <div class="cbar"><span>Factura hoy</span><div class="track"><div class="fill" id="s-b1" style="background:var(--warm)"></div></div><span class="n" id="s-n1"></span></div>
          <div class="cbar"><span>Con solar</span><div class="track"><div class="fill" id="s-b2" style="background:#E3B23C"></div></div><span class="n" id="s-n2"></span></div>
        </div>
        <div class="res-rows">
          <div><span>Instalación recomendada</span><b id="s-kwp"></b></div>
          <div><span>Producción al año</span><b id="s-prod"></b></div>
          <div><span>Ahorro estimado al año</span><b id="s-save"></b></div>
          <div><span>Deducción IRPF, si cumples los requisitos</span><b id="s-irpf-v"></b></div>
          <div><span>Retorno de la inversión</span><b id="s-ret"></b></div>
        </div>
        <p class="calc-note" id="s-warn" hidden></p>
        <details><summary>Ver hipótesis</summary><ul class="q-notes" id="s-hyp"></ul></details>
        <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="solar">Ver mi presupuesto</button><a class="btn btn-ghost" href="/#contacto" data-from="solar">Reservar visita gratis</a></div>
      </div>
    </div>
  )}

  {show("ref") && (
    <div class="calc-grid" role="tabpanel" id="p-ref" aria-labelledby={tabs.length > 1 ? "t-ref" : undefined} hidden={first !== "ref"}>
      <form class="fields" onsubmit="return false">
        <div class="field"><label for="r-type">¿Qué quieres hacer?</label>
          <select id="r-type"><option value="int" selected>Reforma integral de vivienda</option><option value="kit">Reforma de cocina</option><option value="bath">Reforma de baño</option><option value="design">Solo proyecto de interiorismo</option></select></div>
        <div class="field" id="r-m2-f"><label for="r-m2">Superficie: <span class="range-val" id="r-m2-v"></span></label>
          <input type="range" id="r-m2" min="50" max="500" step="10" value="150"></div>
        <div class="field" id="r-n-f" hidden><label for="r-n">Unidades: <span class="range-val" id="r-n-v"></span></label>
          <input type="range" id="r-n" min="1" max="5" step="1" value="1"></div>
        <fieldset class="field" id="r-size-f" hidden><legend>Tamaño</legend>
          <div class="seg">
            <label><input type="radio" name="r-size" value="s"> Pequeña</label>
            <label><input type="radio" name="r-size" value="m" checked> Media</label>
            <label><input type="radio" name="r-size" value="l"> Grande</label>
          </div></fieldset>
        <fieldset class="field"><legend>Nivel de acabados</legend>
          <div class="seg">
            <label><input type="radio" name="r-q" value="0"> Estándar alto</label>
            <label><input type="radio" name="r-q" value="1" checked> Alta</label>
            <label><input type="radio" name="r-q" value="2"> Lujo</label>
          </div></fieldset>
        <label class="chk" for="r-floor"><input type="checkbox" id="r-floor"> Añadir suelo radiante con aerotermia</label>
        <label class="chk" for="r-proj"><input type="checkbox" id="r-proj" checked> Proyecto 3D, licencia y dirección de obra</label>
        <label class="chk" for="r-dom"><input type="checkbox" id="r-dom"> Domótica e iluminación escénica</label>
      </form>
      <div class="result" aria-live="polite">
        <div><p class="eyebrow">Referencia de mercado · IVA incluido</p><div class="big brass" id="r-from">—</div><p class="range-line" id="r-range"></p></div>
        <div class="res-rows">
          <div><span id="r-m2p-l">Precio por m²</span><b id="r-m2p"></b></div>
          <div><span>Plazo de obra estimado</span><b id="r-time"></b></div>
          <div><span>Forma de pago</span><b id="r-pay"></b></div>
        </div>
        <p class="calc-note">En reformas el precio se da siempre bajo proyecto, después de ver la vivienda y definir contigo el alcance y las calidades.</p>
        <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="ref">Ver mi estimación</button><a class="btn btn-ghost" href="/#contacto" data-from="ref">Reservar visita gratis</a></div>
      </div>
    </div>
  )}

  <p class="disclaimer" style="margin-top:28px">Precios orientativos basados en el mercado de Madrid y Toledo, actualizados en {prices.actualizadoTexto}, IVA incluido. En aerotermia y placas, el precio definitivo se fija en la propuesta escrita tras la visita. En reformas, el precio se da bajo proyecto.</p>

  <dialog id="quote" aria-labelledby="q-title">
    <div class="q-sheet">
      <header class="q-head">
        <div><span class="logo">AEROVANTIA<span>.</span></span><p class="q-meta" id="q-meta"></p></div>
        <button class="q-close" type="button" data-close aria-label="Cerrar">×</button>
      </header>
      <p class="eyebrow">Presupuesto orientativo</p>
      <h2 id="q-title"></h2>
      <div class="q-from"><span>Rango</span><b id="q-from"></b><small id="q-to"></small></div>
      <table class="q-lines"><thead><tr><th>Concepto</th><th>Desde</th><th>Hasta</th></tr></thead><tbody id="q-lines"></tbody>
        <tfoot><tr><th>Total estimado</th><th id="q-lo"></th><th id="q-hi"></th></tr></tfoot></table>
      <ul class="q-notes" id="q-notes"></ul>
      <p class="q-legal" id="q-legal"></p>
      <form class="fields" id="q-lead" onsubmit="return false">
        <p class="q-legal">Para descargarlo o enviarlo por WhatsApp, dinos a quién se lo preparamos.</p>
        <div class="two">
          <div class="field"><label for="q-name">Nombre</label><input type="text" id="q-name" autocomplete="name"></div>
          <div class="field"><label for="q-phone">Teléfono</label><input type="tel" id="q-phone" autocomplete="tel" inputmode="tel"></div>
        </div>
        <label class="chk" for="q-rgpd"><input type="checkbox" id="q-rgpd"> <span>He leído la <a href="/privacidad/">política de privacidad</a> y acepto que Aerovantia me contacte sobre este presupuesto.</span></label>
        <p class="err" id="q-err" hidden></p>
      </form>
      <div class="q-actions">
        <a class="btn btn-primary" href="/#contacto" id="q-book">Reservar visita gratis</a>
        <button class="btn btn-ghost" type="button" id="q-pdf">Descargar PDF</button>
        <a class="btn btn-ghost" id="q-wa" href="#" target="_blank" rel="noopener">Enviar por WhatsApp</a>
      </div>
      <p class="q-company" id="q-company"></p>
    </div>
  </dialog>
</div>

<script>
  import "../scripts/calc.js";
</script>
