---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import config from "../data/config.json";
import type { Faq } from "../data/faqs";
import { phone, services, whatsapp } from "../data/site";

export type { Faq };

interface Props {
  /** Color de acento de la página (variable CSS o color). */
  hue: string;
  seoTitle: string;
  description: string;
  eyebrow: string;
  title: string;
  lede: string;
  /** Calculadora a la que lleva el segundo botón. */
  calc?: "aero" | "solar" | "ref";
  facts: { value: string; label: string }[];
  includesTitle: string;
  includesText: string;
  includes: string[];
  cardsTitle: string;
  cards: { title: string; text: string }[];
  faqs: Faq[];
  /** Foto de cabecera y galería de la página. */
  image: ImageMetadata;
  imageAlt: string;
  gallery: { img: ImageMetadata; alt: string }[];
  /** Nombre corto para la miga de pan y el schema. */
  name?: string;
  /** Migas intermedias entre Inicio y esta página. */
  parents?: { name: string; href: string }[];
  og?: string;
}

const p = Astro.props;
const path = Astro.url.pathname;
const name = p.name ?? services.find((s) => s.href === path)?.label ?? p.eyebrow;
const parents = p.parents ?? [];
const calcHref = { aero: "/calculadoras/aerotermia/", solar: "/calculadoras/placas-solares/", ref: "/calculadoras/reformas/" };
const pc = config.primerosClientes;
const crumbs = [{ name: "Inicio", href: "/" }, ...parents, { name, href: path }];

const schema = [
  {
    "@type": "Service",
    name: p.title.replace(/\.$/, ""),
    serviceType: name,
    description: p.description,
    provider: { "@id": new URL("/#empresa", Astro.site).href },
    areaServed: [
      { "@type": "AdministrativeArea", name: "Comunidad de Madrid" },
      { "@type": "AdministrativeArea", name: "Provincia de Toledo" },
    ],
    url: new URL(path, Astro.site).href,
  },
  {
    "@type": "FAQPage",
    mainEntity: p.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })),
  },
];
const others = [...services, { href: "/ayudas/", label: "Ayudas" }].filter((s) => s.href !== path);
---

<Layout title={p.seoTitle} description={p.description} schema={schema} og={p.og}>
  <main style={`--hue:${p.hue}`}>
    <section class="page-hero">
      <Picture src={p.image} alt={p.imageAlt} formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />
      <span class="ai-tag">Imagen ilustrativa generada con IA</span>
      <div class="wrap">
        <nav class="crumbs" aria-label="Ruta">
          {crumbs.map((c, i) => i < crumbs.length - 1 ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">/</span></> : <span>{c.name}</span>)}
        </nav>
        <p class="eyebrow">{p.eyebrow}</p>
        <h1 class="grad">{p.title}</h1>
        <p class="lede">{p.lede}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/#contacto">Pedir estudio gratuito</a>
          {p.calc && <a class="btn btn-ghost" href={calcHref[p.calc]}>Calcular mi proyecto</a>}
          <a class="btn btn-ghost" href={`tel:${phone.tel}`}>Llamar al {phone.display}</a>
        </div>
      </div>
    </section>

    <div class="facts">
      {p.facts.map((f) => <div><b>{f.value}</b><span>{f.label}</span></div>)}
    </div>

    <section>
      <div class="wrap split">
        <div class="sec-head" style="margin:0">
          <p class="eyebrow">Qué incluye</p>
          <h2>{p.includesTitle}</h2>
          <p class="lede">{p.includesText}</p>
        </div>
        <ul class="checks">{p.includes.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section style="padding-top:0">
      <div class="wrap gallery">
        {p.gallery.map((g) => (
          <div class="ai-wrap">
            <Picture class="reveal" src={g.img} alt={g.alt} formats={["avif", "webp"]} widths={[640, 1280]} sizes="(min-width: 768px) 60vw, 100vw" loading="lazy" decoding="async" />
            <span class="ai-tag">Imagen ilustrativa generada con IA</span>
          </div>
        ))}
      </div>
    </section>

    <section class="calc">
      <div class="wrap">
        <div class="sec-head"><p class="eyebrow">Por qué Aerovantia</p><h2>{p.cardsTitle}</h2></div>
        <div class="cards">
          {p.cards.map((c) => <article class="card"><h3>{c.title}</h3><p>{c.text}</p></article>)}
        </div>
      </div>
    </section>

    <slot />

    <section id="faq">
      <div class="wrap">
        <div class="sec-head"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que nos preguntan sobre {name.toLowerCase()}.</h2></div>
        <div class="faq">
          {p.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap">
        <div class="sec-head" style="margin:0">
          <h2>Estudio gratuito y sin compromiso.</h2>
          <p>Visitamos tu casa, revisamos tus facturas y te damos una propuesta por escrito con las ayudas que te aplican. Programa <a href="/primeros-clientes/">Primeros clientes</a>: {pc.condicion}.</p>
        </div>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/#contacto" >Pedir estudio gratuito</a>
          <a class="btn btn-ghost" href={`tel:${phone.tel}`} >Llamar al {phone.display}</a>
          <a class="btn btn-ghost" href={whatsapp.href} target="_blank" rel="noopener" >WhatsApp</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="sec-head"><p class="eyebrow">Otros servicios</p><h2>Energía y reformas, con un solo responsable.</h2></div>
        <div class="cards">
          {others.map((s) => (
            <a class="card" href={s.href} style="text-decoration:none"><h3>{s.label}</h3><span class="more">Ver {s.label.toLowerCase()} <span aria-hidden="true">→</span></span></a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
