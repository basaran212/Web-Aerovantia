---
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Consent from "../components/Consent.astro";
import MobileBar from "../components/MobileBar.astro";
import { company } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Nodos extra de datos estructurados (FAQPage, Service…), sin "@context". */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Imagen para redes (1200×630) en /public/og/. */
  og?: string;
}

const {
  title = "Aerotermia y placas solares en Madrid y Toledo | Aerovantia",
  description = "Estudio gratuito de aerotermia y placas solares en Madrid y Toledo. Ahorro estimado con tu factura, ayudas explicadas y propuesta por escrito.",
  schema = [],
  noindex = false,
  og = "/og/home.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(og, Astro.site);

const business = {
  "@type": ["Organization", "HVACBusiness"],
  "@id": new URL("/#empresa", Astro.site).href,
  name: company.name,
  url: Astro.site?.href,
  logo: new URL("/favicon.svg", Astro.site).href,
  image: ogImage.href,
  description:
    "Aerotermia, placas solares, baterías y cargadores de coche eléctrico, y reformas con la energía integrada, en la Comunidad de Madrid y la provincia de Toledo.",
  legalName: company.legalName,
  taxID: company.cif,
  telephone: company.phones.map((p) => p.tel),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: company.street,
    addressLocality: company.locality,
    addressRegion: company.region,
    addressCountry: "ES",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Comunidad de Madrid" },
    { "@type": "AdministrativeArea", name: "Provincia de Toledo" },
  ],
  knowsAbout: ["Aerotermia", "Bomba de calor", "Suelo radiante", "Energía solar fotovoltaica", "Baterías", "Recarga de vehículo eléctrico", "Reformas"],
};
const jsonLd = { "@context": "https://schema.org", "@graph": [business, ...schema] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#131209" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aerovantia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <div id="contenido" tabindex="-1"></div>
    <slot />
    <Footer />
    <MobileBar />
    <Consent />
    <script>
      import "../scripts/motion.js";
      import "../scripts/clicks.js";
    </script>
  </body>
</html>
