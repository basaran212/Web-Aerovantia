---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MobileBar from "../components/MobileBar.astro";
import { areas, company } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Nodos extra de datos estructurados (FAQPage, Service…), sin "@context". */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = "Aerovantia · Aerotermia, placas solares y reformas de lujo",
  description = "Aerotermia, placas solares y reformas de lujo para chalets en el sur de Madrid y La Sagra (Toledo). Estudio gratuito en 48 h, precio cerrado y gestión de ayudas IRPF y CAE.",
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Los marcadores entre corchetes no se publican como datos estructurados.
const real = (value: string) => (value.startsWith("[") ? undefined : value);
const business = {
  "@type": "HomeAndConstructionBusiness",
  "@id": new URL("/#empresa", Astro.site).href,
  name: company.name,
  url: Astro.site?.href,
  logo: new URL("/favicon.svg", Astro.site).href,
  image: ogImage.href,
  description:
    "Aerotermia, placas solares, baterías, recarga de vehículo eléctrico y reformas de lujo para chalets.",
  telephone: real(company.phone),
  email: real(company.email),
  areaServed: Object.values(areas).flat().map((name) => ({ "@type": "City", name })),
  knowsAbout: ["Aerotermia", "Energía solar fotovoltaica", "Baterías", "Suelo radiante", "Reformas integrales", "Interiorismo"],
};
const jsonLd = { "@context": "https://schema.org", "@graph": [business, ...schema] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0E1C22" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aerovantia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <MobileBar />
  </body>
</html>
