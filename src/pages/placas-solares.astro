---
import ServicePage from "../components/ServicePage.astro";
import exteriorNight from "../assets/img/exterior-night.jpg";
import exteriorNoon from "../assets/img/exterior-noon.jpg";
import solarRoof from "../assets/img/solar-roof.jpg";
---

<ServicePage
  image={solarRoof}
  imageAlt="Vista aérea de una cubierta plana con doce placas solares"
  gallery={[{ img: exteriorNoon, alt: "Chalet con placas solares a mediodía" }, { img: exteriorNight, alt: "El chalet de noche cargando el coche eléctrico" }]}
  hue="#E3B23C"
  calc="solar"
  seoTitle="Placas solares en Toledo y Madrid | Aerovantia"
  description="Placas solares con batería y cargador de coche eléctrico en Toledo y Madrid, calculadas con tu consumo real y con las bonificaciones tramitadas."
  eyebrow="Solar + batería + recarga"
  title="Placas solares en Toledo y Madrid."
  lede="Tu propia energía, de día y de noche. Placas de alta eficiencia, batería y cargador del coche, calculados con tu consumo real. Lo que producen alimenta la casa, carga la batería y el sobrante se compensa en tu factura."
  facts={[
    { value: "1.550–1.620", label: "kWh al año por cada kWp instalado en la zona" },
    { value: "10 kWh", label: "de batería para usar de noche la energía del día" },
    { value: "IBI · ICIO", label: "bonificaciones municipales que revisamos por ti" },
    { value: "VE", label: "recarga del coche en casa, en horas solares o valle" },
  ]}
  includesTitle="Dimensionada con tus facturas, no a ojo."
  includesText="Partimos de tu consumo de los últimos 12 meses, la orientación de la cubierta y lo que vas a añadir: aerotermia, coche eléctrico o piscina."
  includes={[
    "Estudio de consumo y de cubierta con simulación de producción",
    "Paneles N-type de alta eficiencia",
    "Inversor Huawei, SolarEdge o Fronius",
    "Batería BYD o Tesla Powerwall (opcional)",
    "Cargador de vehículo eléctrico Wallbox (opcional)",
    "Legalización del autoconsumo con compensación de excedentes",
    "Monitorización desde el móvil y tramitación de bonificaciones",
  ]}
  cardsTitle="Más energía tuya, menos factura."
  cards={[
    { title: "Con aerotermia", text: "En un chalet, combinar placas y aerotermia es lo que más ahorra: la casa calienta y enfría con la electricidad que produce." },
    { title: "Batería y coche", text: "La batería guarda lo que sobra a mediodía para la noche, y el cargador prioriza la energía solar o las horas valle." },
    { title: "Instalación limpia", text: "Cableado oculto, estructura adaptada a tu cubierta y un único responsable de proyecto de la visita a la puesta en marcha." },
  ]}
  faqs={[
    { q: "¿Cuántas placas necesito?", a: "Depende de tu consumo y de tu cubierta. Para un chalet con una factura media, suelen salir entre 8 y 16 paneles. La calculadora de la portada te da una primera estimación." },
    { q: "¿Compensa poner batería?", a: "Si pasas poco tiempo en casa durante el día, o si tienes aerotermia o coche eléctrico, normalmente sí: sube mucho el porcentaje de energía que consumes de tus placas." },
    { q: "¿Qué pasa con la energía que no uso?", a: "Se vierte a la red y tu comercializadora te la descuenta en la factura mediante la compensación simplificada de excedentes." },
    { q: "¿Necesito licencia?", a: "Según el municipio, una comunicación previa o licencia de obra menor. La tramitamos nosotros, junto con la legalización de la instalación." },
    { q: "¿Qué mantenimiento tienen?", a: "Muy poco: una revisión periódica y, si hace falta, limpieza de los paneles. Con la monitorización vemos si algo deja de rendir." },
  ]}
/>
