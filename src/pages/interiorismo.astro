---
import ServicePage from "../components/ServicePage.astro";
import bath from "../assets/img/bath.jpg";
import kitchen from "../assets/img/kitchen.jpg";
import living from "../assets/img/living.jpg";
---

<ServicePage
  image={living}
  imageAlt="Salón con sofá de lino, mesa de travertino y estanterías de roble"
  gallery={[{ img: kitchen, alt: "Cocina abierta con isla de mármol y lámparas de latón" }, { img: bath, alt: "Baño de travertino con lavabo de piedra" }]}
  hue="var(--brass)"
  calc="ref"
  seoTitle="Interiorismo en Toledo y Madrid sur | Aerovantia"
  description="Interiorismo para chalets y viviendas en Toledo y Madrid sur: proyecto 3D, materiales, iluminación y mobiliario a medida, y la obra con el mismo equipo."
  eyebrow="Interiorismo y diseño interior"
  title="Interiorismo en Toledo y Madrid sur."
  lede="Ves tu casa terminada antes de empezar. Diseñamos la distribución, los materiales, la iluminación y el mobiliario a medida, y la misma empresa lo ejecuta en obra, sin intermediarios."
  facts={[
    { value: "3D", label: "renders de tu casa antes de empezar la obra" },
    { value: "1 equipo", label: "que diseña y ejecuta: lo dibujado es lo que se construye" },
    { value: "A medida", label: "carpintería, mobiliario e iluminación" },
    { value: "Precio cerrado", label: "proyecto y obra en una sola propuesta" },
  ]}
  includesTitle="Del primer boceto a la última lámpara."
  includesText="Partimos de cómo vivís en la casa y lo convertimos en un proyecto con planos, renders y una selección de materiales que podrás tocar antes de decidir."
  includes={[
    "Toma de datos y planos del estado actual",
    "Propuesta de distribución y renders 3D",
    "Selección de materiales sobre muestras reales",
    "Proyecto de iluminación y domótica",
    "Carpintería y mobiliario a medida",
    "Coordinación con la reforma o la obra nueva",
    "Estilismo final: textiles, decoración y menaje",
  ]}
  cardsTitle="Diseño que se puede construir."
  cards={[
    { title: "Diseño y obra juntos", text: "El mismo equipo dibuja y ejecuta, así que el diseño se ajusta al presupuesto y a la obra desde el principio." },
    { title: "Confort invisible", text: "Escondemos la técnica: suelo radiante bajo la madera, aerotermia sin radiadores a la vista e iluminación integrada." },
    { title: "Materiales nobles", text: "Mármol, roble, travertino, microcemento y latón, elegidos contigo según el uso de cada espacio." },
  ]}
  faqs={[
    { q: "¿Puedo contratar solo el proyecto de interiorismo?", a: "Sí. Aunque lo habitual es que también ejecutemos la obra, puedes contratar solo el proyecto con planos, renders y selección de materiales." },
    { q: "¿Cuánto tarda el proyecto?", a: "Depende del tamaño de la vivienda y de cuántas propuestas revisemos juntos. Te damos el calendario en la propuesta inicial." },
    { q: "¿Trabajáis en obra nueva?", a: "Sí. En obra nueva es el mejor momento: definimos el interiorismo junto a las instalaciones, antes de cerrar paredes y suelos." },
    { q: "¿Cómo se calcula el precio?", a: "Por superficie y nivel de acabados. La calculadora de reformas de la portada incluye la opción de interiorismo y te da un rango orientativo." },
  ]}
/>
