---
import ServicePage from "../components/ServicePage.astro";
import bath from "../assets/img/bath.jpg";
import kitchen from "../assets/img/kitchen.jpg";
import living from "../assets/img/living.jpg";
---

<ServicePage
  image={living}
  imageAlt="Recreación ilustrativa con IA: salón con sofá de lino, mesa de travertino y estanterías de roble"
  gallery={[{ img: kitchen, alt: "Recreación ilustrativa con IA: cocina abierta con isla de mármol y lámparas de latón" }, { img: bath, alt: "Recreación ilustrativa con IA: baño de travertino con lavabo de piedra" }]}
  hue="var(--brass)"
  calc="ref"
  og="/og/interiorismo.png"
  parents={[{ name: "Reformas", href: "/reformas/" }]}
  name="Interiorismo"
  seoTitle="Interiorismo y proyecto 3D en Madrid y Toledo | Aerovantia"
  description="Interiorismo para chalets y viviendas en Madrid y Toledo: proyecto 3D, materiales, iluminación y mobiliario a medida, coordinado con la reforma y la energía."
  eyebrow="Interiorismo y diseño interior"
  title="Interiorismo en Madrid y Toledo."
  lede="Ves tu casa terminada antes de empezar. Diseñamos la distribución, los materiales, la iluminación y el mobiliario a medida, y lo coordinamos con la reforma y con la instalación de la energía."
  facts={[
    { value: "3D", label: "renders de tu casa antes de empezar la obra" },
    { value: "1 responsable", label: "que coordina el diseño con la obra y las instalaciones" },
    { value: "A medida", label: "carpintería, mobiliario e iluminación" },
    { value: "Bajo proyecto", label: "precio del proyecto y de la obra en una propuesta por escrito" },
  ]}
  includesTitle="Del primer boceto a la última lámpara."
  includesText="Partimos de cómo vivís en la casa y lo convertimos en un proyecto con planos, renders y una selección de materiales que podrás tocar antes de decidir."
  includes={[
    "Toma de datos y planos del estado actual",
    "Propuesta de distribución y renders 3D",
    "Selección de materiales sobre muestras reales",
    "Proyecto de iluminación y domótica",
    "Carpintería y mobiliario a medida",
    "Coordinación con la reforma y las instalaciones",
    "Estilismo final: textiles, decoración y menaje",
  ]}
  cardsTitle="Diseño que se puede construir."
  cards={[
    { title: "Diseño y obra coordinados", text: "El diseño se ajusta al presupuesto y a la obra desde el principio, con un único responsable." },
    { title: "Confort invisible", text: "Escondemos la técnica: suelo radiante bajo la madera, aerotermia sin radiadores a la vista e iluminación integrada." },
    { title: "Materiales nobles", text: "Mármol, roble, travertino, microcemento y latón, elegidos contigo según el uso de cada espacio." },
  ]}
  faqs={[
    { q: "¿Puedo contratar solo el proyecto de interiorismo?", a: "Sí. Puedes contratar solo el proyecto con planos, renders y selección de materiales, o el proyecto junto con la reforma." },
    { q: "¿Cuánto tarda el proyecto?", a: "Depende del tamaño de la vivienda y de cuántas propuestas revisemos juntos. Te damos el calendario en la propuesta inicial." },
    { q: "¿Trabajáis en obra nueva?", a: "Sí. En obra nueva es el mejor momento: definimos el interiorismo junto a las instalaciones, antes de cerrar paredes y suelos." },
    { q: "¿Cómo se calcula el precio?", a: "Por superficie y nivel de acabados. La calculadora de reformas incluye la opción de interiorismo y te da un rango de referencia; el precio se da bajo proyecto." },
  ]}
/>
