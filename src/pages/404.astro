---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada · Aerovantia" description="La página que buscas no existe." noindex>
  <main>
    <section class="page-hero plain">
      <div class="wrap">
        <p class="eyebrow">Error 404</p>
        <h1>Esta página no existe.</h1>
        <p class="lede">Puede que el enlace haya cambiado. Prueba con las calculadoras o escríbenos.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/calculadoras/">Calculadoras</a>
          <a class="btn btn-ghost" href="/aerotermia/">Aerotermia</a>
          <a class="btn btn-ghost" href="/placas-solares/">Placas solares</a>
          <a class="btn btn-ghost" href="/#contacto">Contacto</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
