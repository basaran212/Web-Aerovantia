---
import { Picture } from "astro:assets";

import Layout from "../../layouts/Layout.astro";
import { projectHref, projects, projectTypes } from "../../data/proyectos";

const crumbs = [{ name: "Inicio", href: "/" }, { name: "Proyectos", href: "/proyectos/" }];
const schema = [{ "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })) }];
---

<Layout title="Proyectos de reformas y viviendas | Aerovantia" description="Obras ejecutadas, proyectos en desarrollo y visualizaciones conceptuales de Aerovantia en Madrid y Toledo, siempre separadas y señaladas." schema={schema}>
  <main>
    <section class="page-hero plain">
      <div class="wrap">
        <nav class="crumbs" aria-label="Ruta"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Proyectos</span></nav>
        <p class="eyebrow">Proyectos</p>
        <h1>Proyectos.</h1>
        <p class="lede">Separamos siempre las obras ejecutadas, los proyectos en desarrollo y las visualizaciones conceptuales. Somos una marca nueva: hoy solo hay visualizaciones, y lo decimos.</p>
      </div>
    </section>
    <section style="padding-top:24px">
      <div class="wrap">
        <div class="filters" role="group" aria-label="Filtrar proyectos" data-filters>
          <button type="button" aria-pressed="true" data-filter="all">Todos</button>
          {projectTypes.map((t) => <button type="button" aria-pressed="false" data-filter={t.k}>{t.plural}</button>)}
        </div>
        {projectTypes.map((t) => {
          const list = projects.filter((p) => p.type === t.k);
          return (
            <div class="proj-block" data-type={t.k} style="display:grid;gap:24px;margin-bottom:72px">
              <h2 style="font-size:clamp(26px,3vw,36px)">{t.plural}</h2>
              {list.length ? (
                <div class="proj-grid three">
                  {list.map((p) => (
                    <a class="proj" href={projectHref(p)}>
                      <div class="proj-media">
                        <Picture src={p.cover} alt={p.coverAlt} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 1100px) 33vw, (min-width: 768px) 50vw, 100vw" loading="lazy" decoding="async" />
                        {p.type === "conceptual" && <span class="ai-tag">Visualización conceptual · IA</span>}
                      </div>
                      <span class="type">{t.label}</span>
                      <h3>{p.title}</h3>
                      <p>{p.summary}</p>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="empty"><strong>Aún no hay {t.plural.toLowerCase()} publicadas.</strong><span>{t.empty}</span>{t.k === "ejecutada" && <a class="text-link" href="/primeros-clientes/">Programa Primeros clientes <span aria-hidden="true">→</span></a>}</div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filters]");
  if (bar) {
    const blocks = [...document.querySelectorAll<HTMLElement>(".proj-block")];
    bar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!btn) return;
      bar.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      blocks.forEach((b) => { b.hidden = btn.dataset.filter !== "all" && b.dataset.type !== btn.dataset.filter; });
    });
  }
</script>
