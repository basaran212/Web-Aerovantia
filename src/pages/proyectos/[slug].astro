---
import { Picture } from "astro:assets";

import Layout from "../../layouts/Layout.astro";
import { projects, projectTypes } from "../../data/proyectos";
import type { Project } from "../../data/proyectos";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const type = projectTypes.find((t) => t.k === p.type)!;
const crumbs = [{ name: "Inicio", href: "/" }, { name: "Proyectos", href: "/proyectos/" }, { name: p.title, href: `/proyectos/${p.slug}/` }];
const schema = [{ "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })) }];
const conceptual = p.type === "conceptual";
---

<Layout title={`${p.title}${conceptual ? " (concepto)" : ""} | Aerovantia`} description={`${p.summary}${conceptual ? " Visualización conceptual con IA, no es una obra." : ""}`} schema={schema}>
  <main>
    <section class="page-hero plain">
      <div class="wrap">
        <nav class="crumbs" aria-label="Ruta"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/proyectos/">Proyectos</a><span aria-hidden="true">/</span><span>{p.title}</span></nav>
        <p class="eyebrow">{type.label}</p>
        <h1>{p.title}</h1>
        <p class="lede">{p.summary}</p>
        {conceptual && <p class="note">Visualización conceptual generada con inteligencia artificial. No es una obra realizada.</p>}
      </div>
    </section>
    <section style="padding-top:16px">
      <div class="wrap" style="display:grid;gap:24px">
        <div class="proj-media" style="aspect-ratio:16/9">
          <Picture src={p.cover} alt={p.coverAlt} formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1200px) 1200px, 100vw" loading="eager" fetchpriority="high" decoding="async" />
          {conceptual && <span class="ai-tag">Visualización conceptual · IA</span>}
        </div>
        <dl class="spec">{p.spec.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}</dl>
        <div class="prose" style="margin-top:24px">{p.body.map((t) => <p>{t}</p>)}</div>
        <div class="proj-grid">
          {p.images.map((im) => (
            <div class="proj-media" style="aspect-ratio:16/10">
              <Picture src={im.img} alt={im.alt} formats={["avif", "webp"]} widths={[640, 960, 1280]} sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" decoding="async" />
              {conceptual && <span class="ai-tag">Visualización conceptual · IA</span>}
            </div>
          ))}
        </div>
        <p style="display:flex;flex-wrap:wrap;gap:24px">{p.links.map((l) => <a class="text-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}<a class="text-link" href="/proyectos/">Todos los proyectos <span aria-hidden="true">→</span></a></p>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <div class="sec-head" style="margin:0"><h2>Tu próximo espacio empieza con una conversación.</h2></div>
        <div class="hero-ctas"><a class="btn btn-primary" href="/#contacto">Hablemos de tu proyecto</a></div>
      </div>
    </section>
  </main>
</Layout>
