---
import ServicePage from "../components/ServicePage.astro";
---

<ServicePage
  hue="var(--warm)"
  seoTitle="Instalaciones eficientes para obra nueva y promotores · Aerovantia"
  description="Aerotermia, suelo radiante, fotovoltaica y recarga para chalets y promociones de nueva construcción en el sur de Madrid y Toledo. Diseñadas con el proyecto de arquitectura, llave en mano."
  eyebrow="Obra nueva y promotores"
  title="Viviendas nuevas, eficientes desde el plano."
  lede="Diseñamos soluciones completas para viviendas de nueva construcción con alta eficiencia energética: climatización, agua caliente, fotovoltaica y recarga, coordinadas con el arquitecto y el constructor."
  facts={[
    { value: "Desde plano", label: "entramos en el proyecto antes de que empiece la obra" },
    { value: "CTE", label: "instalaciones pensadas para cumplir el Código Técnico" },
    { value: "Llave en mano", label: "diseño, instalación, legalización y puesta en marcha" },
    { value: "1 interlocutor", label: "para la dirección facultativa y el constructor" },
  ]}
  includesTitle="Las instalaciones, resueltas antes de la primera piedra."
  includesText="Cuanto antes entramos, mejor encaja todo: huecos, pasos de instalaciones, cubierta, ubicación de equipos y presupuesto."
  includes={[
    "Diseño de instalaciones junto al proyecto básico y de ejecución",
    "Aerotermia con suelo radiante y agua caliente sanitaria",
    "Fotovoltaica, batería y preinstalación de recarga",
    "Coordinación de calendario con el constructor",
    "Legalización, boletines y apoyo para el certificado energético",
    "Documentación y manuales de uso para el propietario",
    "Soluciones repetibles por tipología para promociones",
  ]}
  cardsTitle="Para propietarios, arquitectos y promotores."
  cards={[
    { title: "Si te haces la casa", text: "Te ayudamos a decidir el sistema con el arquitecto y lo ejecutamos durante la obra, con un precio cerrado desde el principio." },
    { title: "Si eres arquitecto", text: "Te damos el diseño y los datos de las instalaciones para el proyecto, y un interlocutor técnico durante la obra." },
    { title: "Si eres promotor", text: "Definimos una solución por tipología, con plazos coordinados y la documentación energética que pide la venta." },
  ]}
  faqs={[
    { q: "¿Cuándo conviene contar con vosotros?", a: "Lo ideal es durante el proyecto básico o de ejecución, antes de empezar la obra. También entramos con la obra empezada, revisando lo que ya está previsto." },
    { q: "¿Trabajáis con mi constructor?", a: "Sí. Nos encargamos de las instalaciones energéticas y coordinamos los plazos con el constructor y la dirección facultativa." },
    { q: "¿Hacéis promociones de varias viviendas?", a: "Sí. Definimos una solución por tipología para que la instalación, el presupuesto y los plazos sean repetibles." },
    { q: "¿Qué garantía tiene la instalación?", a: "La garantía del fabricante de los equipos y nuestra propia garantía sobre la instalación." },
  ]}
/>
