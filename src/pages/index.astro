---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";

import ScrollWorld from "../components/ScrollWorld.astro";
import { company, whatsapp } from "../data/site";
import bath from "../assets/img/bath.jpg";
import heatpump from "../assets/img/heatpump.jpg";
import kitchenBefore from "../assets/img/kitchen-before.jpg";
import kitchen from "../assets/img/kitchen.jpg";
import living from "../assets/img/living.jpg";
import matBrass from "../assets/img/mat-brass.jpg";
import matMarble from "../assets/img/mat-marble.jpg";
import matMicro from "../assets/img/mat-micro.jpg";
import matOak from "../assets/img/mat-oak.jpg";
import matTrav from "../assets/img/mat-trav.jpg";
import newbuild from "../assets/img/newbuild.jpg";
import solarRoof from "../assets/img/solar-roof.jpg";

const faqs = [
  { q: "¿Hacéis reformas, obra nueva e interiorismo, o solo instalaciones?", a: "Las tres cosas. Hacemos reformas integrales, obra nueva e interiorismo, y además integramos la aerotermia, el suelo radiante y las placas solares en la misma obra, con un único responsable y un único presupuesto." },
  { q: "¿En qué zonas trabajáis?", a: "Tenemos la oficina en Olías del Rey (Toledo) y trabajamos en Toledo, La Sagra (Illescas, Seseña, Yuncos, Esquivias…) y la Comunidad de Madrid (Getafe, Leganés, Móstoles, Boadilla, Villaviciosa de Odón…). Si tu municipio no está en la lista, pregúntanos." },
  { q: "¿Cuánto cuesta el estudio?", a: "Nada. La visita técnica y la propuesta con precio cerrado son gratuitas y sin compromiso." },
  { q: "¿La aerotermia funciona con mis radiadores?", a: "Con radiadores de baja temperatura o sobredimensionados, sí. Con radiadores convencionales a veces hay que cambiar algunos. Si reformas, lo ideal es suelo radiante." },
  { q: "¿Cuánto dura una reforma integral?", a: "Entre 3 y 6 meses según superficie y nivel de acabados. Te damos un calendario por fases y penalizaciones por retraso en el contrato." },
  { q: "¿Puedo vivir en la casa durante la obra?", a: "En cocinas, baños o instalaciones energéticas, normalmente sí. En una reforma integral recomendamos no hacerlo; planificamos fases si no hay alternativa." },
  { q: "¿Compensa combinar aerotermia y placas?", a: "En un chalet, normalmente sí: la aerotermia consume electricidad y las placas la producen en casa. Las calculamos juntas." },
  { q: "¿Necesito licencia?", a: "Según el municipio, una comunicación previa, licencia de obra menor o mayor. La tramitamos nosotros." },
  { q: "¿Qué pasa si hay una avería?", a: "Durante la garantía gestionamos la reparación con el fabricante. Con Care+ tienes revisión anual y atención prioritaria." },
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const tagline = "Reformamos tu casa y la hacemos eficiente. Un solo equipo, un precio cerrado y la factura de la luz al mínimo.";

const services = [
  { href: "/reformas-de-lujo/", tag: "Reformas integrales", title: "Reformas de lujo, llave en mano", text: "Cocinas, baños y distribución con materiales nobles, proyecto 3D y dirección de obra propia.", img: kitchen, alt: "Cocina reformada con isla de mármol, madera de roble y lámparas de latón" },
  { href: "/obra-nueva/", tag: "Obra nueva", title: "Tu casa nueva, eficiente desde el plano", text: "Chalets llave en mano con aerotermia, suelo radiante y placas solares desde el proyecto.", img: newbuild, alt: "Estructura de hormigón de un chalet en construcción en el campo de Toledo" },
  { href: "/interiorismo/", tag: "Interiorismo", title: "Diseño interior con proyecto 3D", text: "Distribución, materiales, iluminación y mobiliario a medida.", img: living, alt: "Salón con sofá de lino, mesa de travertino y luz cálida de tarde" },
  { href: "/aerotermia/", tag: "Aerotermia", title: "Calefacción, frío y agua caliente", text: "Bomba de calor que sustituye tu caldera y ahorra hasta un 70 %.", img: heatpump, alt: "Unidad exterior de aerotermia junto a la fachada blanca de una casa" },
  { href: "/placas-solares/", tag: "Placas solares", title: "Produce tu propia energía", text: "Paneles, batería y cargador del coche, calculados con tu consumo real.", img: solarRoof, alt: "Vista aérea de una cubierta con placas solares y piscina" },
];

const materials = [
  { img: matMarble, name: "Mármol Calacatta", use: "Encimeras y baños" },
  { img: matOak, name: "Roble natural", use: "Suelos y carpintería" },
  { img: matTrav, name: "Travertino", use: "Paredes y escaleras" },
  { img: matMicro, name: "Microcemento", use: "Continuidad sin juntas" },
  { img: matBrass, name: "Latón cepillado", use: "Grifería y detalles" },
];
---

<Layout schema={schema}>
<main>
  <ScrollWorld />

  <div class="deadline">
    <div class="wrap">
      <div class="date">Hasta 31.12.2026</div>
      <p><strong>Deducción del 40&nbsp;% en el IRPF</strong> si la instalación reduce un 30&nbsp;% el consumo de energía no renovable o la vivienda llega a calificación A o B. El certificado energético debe estar emitido antes de fin de año.</p>
      <a class="btn btn-ghost" href="#ayudas">Ver ayudas</a>
    </div>
  </div>

  <section class="tagline" aria-label="Lo que hacemos">
    <div class="wrap">
      <p data-words>{tagline.split(" ").map((w) => <><span data-word>{w}</span>{" "}</>)}</p>
    </div>
  </section>

  <section id="servicios" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Qué hacemos</p>
        <h2>Construimos, reformamos y hacemos eficiente tu casa.</h2>
        <p class="lede">Reformas integrales, obra nueva e interiorismo con la aerotermia y las placas solares ya integradas. Un único responsable y un único presupuesto.</p>
      </div>
      <div class="bento">
        {services.map((s, i) => (
          <a class="tile reveal" href={s.href}>
            <Picture src={s.img} alt={s.alt} formats={["avif", "webp"]} widths={[640, 960, 1440]} sizes={i === 0 ? "(min-width: 768px) 66vw, 100vw" : "(min-width: 768px) 33vw, 100vw"} loading="lazy" decoding="async" />
            <div class="body">
              <span class="tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="more">Ver {s.tag.toLowerCase()} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="reformas" class="calc">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Reformas integrales e interiorismo</p>
        <h2>De casa anticuada a casa de revista.</h2>
        <p class="lede">Desliza para ver la diferencia. Quitamos radiadores y caldera, abrimos espacios, metemos suelo radiante bajo la madera y dejamos la casa lista para producir su propia energía.</p>
      </div>
      <div class="ref-grid">
        <div class="ba reveal" data-ba>
          <Picture src={kitchen} alt="Cocina después de la reforma, con isla de mármol y roble" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" />
          <Picture src={kitchenBefore} alt="La misma cocina antes de la reforma, con muebles de los años noventa" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" class="before" />
          <span class="handle" aria-hidden="true"></span>
          <span class="lbl l">Antes</span><span class="lbl r">Después</span>
          <input type="range" min="0" max="100" value="50" aria-label="Deslizar entre antes y después de la reforma" />
        </div>
        <div class="ref-points">
          <div><h3>Reforma integral</h3><p>Distribución, instalaciones, carpintería y acabados con un único director de obra.</p></div>
          <div><h3>Cocinas y baños</h3><p>Islas de piedra natural, electrodomésticos de gama alta, duchas a ras de suelo y grifería termostática.</p></div>
          <div><h3>Interiorismo</h3><p>Proyecto 3D, selección de materiales, iluminación y mobiliario a medida.</p></div>
          <div><h3>Energía integrada</h3><p>Suelo radiante, aerotermia oculta y domótica: confort invisible y factura mínima.</p></div>
        </div>
      </div>
      <div class="swatches" aria-label="Materiales">
        {materials.map((m) => (
          <div class="sw reveal">
            <Picture src={m.img} alt={m.name} formats={["avif", "webp"]} widths={[320, 480]} sizes="(min-width: 640px) 20vw, 50vw" loading="lazy" decoding="async" />
            <span><b>{m.name}</b>{m.use}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="calculadoras">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Presupuesto al instante</p>
        <h2>Calcula el precio de tu obra en 30 segundos.</h2>
        <p class="lede">Precios reales de mercado en Toledo y Madrid, IVA incluido. Elige tu proyecto, ajusta los datos y descarga tu presupuesto orientativo al momento.</p>
      </div>
      <div class="tabs" role="tablist">
        <button class="tab" role="tab" id="t-ref" data-k="ref" aria-selected="true" aria-controls="p-ref">Reformas e interiorismo</button>
        <button class="tab" role="tab" id="t-obra" data-k="obra" aria-selected="false" aria-controls="p-obra">Obra nueva</button>
        <button class="tab" role="tab" id="t-aero" data-k="aero" aria-selected="false" aria-controls="p-aero">Aerotermia</button>
        <button class="tab" role="tab" id="t-solar" data-k="solar" aria-selected="false" aria-controls="p-solar">Placas solares</button>
      </div>

      <!-- REFORMAS E INTERIORISMO -->
      <div class="calc-grid" role="tabpanel" id="p-ref" aria-labelledby="t-ref">
        <form class="fields" onsubmit="return false">
          <div class="field"><label for="r-type">¿Qué quieres hacer?</label>
            <select id="r-type"><option value="int" selected>Reforma integral de vivienda</option><option value="kit">Reforma de cocina</option><option value="bath">Reforma de baño</option><option value="design">Solo proyecto de interiorismo</option></select></div>
          <div class="field" id="r-m2-f"><label for="r-m2">Superficie: <span class="range-val" id="r-m2-v"></span></label>
            <input type="range" id="r-m2" min="50" max="500" step="10" value="150"></div>
          <div class="field" id="r-n-f" hidden><label for="r-n">Unidades: <span class="range-val" id="r-n-v"></span></label>
            <input type="range" id="r-n" min="1" max="5" step="1" value="1"></div>
          <fieldset class="field"><legend>Nivel de acabados</legend>
            <div class="seg">
              <label><input type="radio" name="r-q" value="0"> Estándar alto</label>
              <label><input type="radio" name="r-q" value="1" checked> Alta</label>
              <label><input type="radio" name="r-q" value="2"> Lujo</label>
            </div></fieldset>
          <label class="chk" for="r-floor"><input type="checkbox" id="r-floor"> Añadir suelo radiante con aerotermia</label>
          <label class="chk" for="r-proj"><input type="checkbox" id="r-proj" checked> Proyecto 3D, licencia y dirección de obra</label>
          <label class="chk" for="r-dom"><input type="checkbox" id="r-dom"> Domótica e iluminación escénica</label>
        </form>
        <div class="result" aria-live="polite">
          <div><p class="eyebrow">Precio estimado · IVA incluido</p><div class="big brass" id="r-from">—</div><p class="range-line" id="r-range"></p></div>
          <div class="res-rows">
            <div><span>Precio por m²</span><b id="r-m2p"></b></div>
            <div><span>Plazo de obra estimado</span><b id="r-time"></b></div>
            <div><span>Forma de pago</span><b id="r-pay"></b></div>
          </div>
          <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="ref">Ver mi presupuesto</button><a class="btn btn-ghost" href="#contacto" data-from="ref">Reservar visita gratis</a></div>
        </div>
      </div>

      <!-- OBRA NUEVA -->
      <div class="calc-grid" role="tabpanel" id="p-obra" aria-labelledby="t-obra" hidden>
        <form class="fields" onsubmit="return false">
          <div class="field"><label for="o-m2">Superficie construida: <span class="range-val" id="o-m2-v"></span></label>
            <input type="range" id="o-m2" min="90" max="500" step="10" value="180"><small>Sin contar el terreno.</small></div>
          <fieldset class="field"><legend>Nivel de calidades</legend>
            <div class="seg">
              <label><input type="radio" name="o-q" value="0"> Estándar alto</label>
              <label><input type="radio" name="o-q" value="1" checked> Alta</label>
              <label><input type="radio" name="o-q" value="2"> Lujo</label>
            </div></fieldset>
          <label class="chk" for="o-energy"><input type="checkbox" id="o-energy" checked> Aerotermia con suelo radiante y placas solares</label>
          <label class="chk" for="o-soft"><input type="checkbox" id="o-soft" checked> Proyecto, dirección facultativa, licencia e ICIO</label>
          <label class="chk" for="o-pool"><input type="checkbox" id="o-pool"> Piscina</label>
        </form>
        <div class="result" aria-live="polite">
          <div><p class="eyebrow">Precio estimado · IVA incluido</p><div class="big brass" id="o-from">—</div><p class="range-line" id="o-range"></p></div>
          <div class="res-rows">
            <div><span>Precio por m² construido</span><b id="o-m2p"></b></div>
            <div><span>Plazo de obra estimado</span><b id="o-time"></b></div>
            <div><span>Terreno</span><b>No incluido</b></div>
          </div>
          <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="obra">Ver mi presupuesto</button><a class="btn btn-ghost" href="#contacto" data-from="obra">Reservar visita gratis</a></div>
        </div>
      </div>

      <!-- AEROTERMIA -->
      <div class="calc-grid" role="tabpanel" id="p-aero" aria-labelledby="t-aero" hidden>
        <form class="fields" onsubmit="return false">
          <div class="field"><label for="a-fuel">Sistema actual</label>
            <select id="a-fuel"><option value="gasoleo" selected>Caldera de gasóleo</option><option value="propano">Caldera de propano</option><option value="gas">Caldera de gas natural</option><option value="elec">Radiadores o acumuladores eléctricos</option></select></div>
          <div class="field"><label for="a-spend">Gasto anual en calefacción y agua caliente: <span class="range-val" id="a-spend-v"></span></label>
            <input type="range" id="a-spend" min="800" max="6000" step="100" value="2400"><small>Suma de facturas o llenados de depósito de 12 meses.</small></div>
          <div class="field"><label for="a-m2">Superficie calefactada: <span class="range-val" id="a-m2-v"></span></label>
            <input type="range" id="a-m2" min="60" max="450" step="10" value="180"></div>
          <div class="field"><label for="a-emit">Cómo se reparte el calor</label>
            <select id="a-emit"><option value="keep" selected>Mantengo mis radiadores</option><option value="radiators">Radiadores nuevos de baja temperatura</option><option value="floor">Suelo radiante nuevo</option></select></div>
          <div class="field"><label for="a-zone">Zona</label>
            <select id="a-zone"><option value="C4" selected>Toledo y La Sagra</option><option value="D3">Comunidad de Madrid</option></select></div>
          <label class="chk" for="a-irpf"><input type="checkbox" id="a-irpf" checked> Vivienda habitual o alquilada (deducción IRPF del 40&nbsp;%)</label>
        </form>
        <div class="result" aria-live="polite">
          <div><p class="eyebrow">Precio estimado · IVA incluido</p><div class="big" id="a-from">—</div><p class="range-line" id="a-range"></p></div>
          <div class="compare">
            <div class="cbar"><span>Gasto hoy</span><div class="track"><div class="fill" id="a-b1" style="background:var(--warm)"></div></div><span class="n" id="a-n1"></span></div>
            <div class="cbar"><span>Aerotermia</span><div class="track"><div class="fill" id="a-b2" style="background:var(--cold)"></div></div><span class="n" id="a-n2"></span></div>
          </div>
          <div class="res-rows">
            <div><span>Ahorro estimado al año</span><b id="a-save"></b></div>
            <div><span>Deducción IRPF estimada</span><b id="a-irpf-v"></b></div>
            <div><span>Retorno de la inversión</span><b id="a-ret"></b></div>
          </div>
          <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="aero">Ver mi presupuesto</button><a class="btn btn-ghost" href="#contacto" data-from="aero">Reservar visita gratis</a></div>
        </div>
      </div>

      <!-- SOLAR -->
      <div class="calc-grid" role="tabpanel" id="p-solar" aria-labelledby="t-solar" hidden>
        <form class="fields" onsubmit="return false">
          <div class="field"><label for="s-bill">Factura de luz media al mes: <span class="range-val" id="s-bill-v"></span></label>
            <input type="range" id="s-bill" min="40" max="450" step="5" value="120"></div>
          <div class="field"><label for="s-zone">Zona</label>
            <select id="s-zone"><option value="C4" selected>Toledo y La Sagra</option><option value="D3">Comunidad de Madrid</option></select></div>
          <div class="field"><label for="s-roof">Orientación de la cubierta</label>
            <select id="s-roof"><option value="1" selected>Sur o cubierta plana</option><option value="0.9">Sureste / suroeste</option><option value="0.8">Este / oeste</option></select></div>
          <div class="field"><label for="s-bat">Batería</label>
            <select id="s-bat"><option value="0">Sin batería</option><option value="5" selected>5 kWh</option><option value="10">10 kWh</option></select></div>
          <label class="chk" for="s-aero"><input type="checkbox" id="s-aero"> También instalo aerotermia (sube el consumo eléctrico)</label>
          <label class="chk" for="s-ev"><input type="checkbox" id="s-ev"> Añadir cargador para coche eléctrico</label>
        </form>
        <div class="result" aria-live="polite">
          <div><p class="eyebrow">Precio estimado · IVA incluido</p><div class="big" id="s-from" style="color:#B7861B">—</div><p class="range-line" id="s-range"></p></div>
          <div class="compare">
            <div class="cbar"><span>Factura hoy</span><div class="track"><div class="fill" id="s-b1" style="background:var(--warm)"></div></div><span class="n" id="s-n1"></span></div>
            <div class="cbar"><span>Con solar</span><div class="track"><div class="fill" id="s-b2" style="background:#E3B23C"></div></div><span class="n" id="s-n2"></span></div>
          </div>
          <div class="res-rows">
            <div><span>Instalación recomendada</span><b id="s-kwp"></b></div>
            <div><span>Ahorro estimado al año</span><b id="s-save"></b></div>
            <div><span>Retorno de la inversión</span><b id="s-ret"></b></div>
          </div>
          <div class="quote-ctas"><button class="btn btn-primary" type="button" data-quote="solar">Ver mi presupuesto</button><a class="btn btn-ghost" href="#contacto" data-from="solar">Reservar visita gratis</a></div>
        </div>
      </div>
      <p class="disclaimer" style="margin-top:28px">Estimaciones orientativas con precios de mercado de 2026 para Toledo y Madrid, IVA incluido. No incluyen mobiliario suelto ni partidas no indicadas. El precio definitivo y cerrado se entrega por escrito tras la visita técnica gratuita.</p>
    </div>
  </section>

  <dialog id="quote" aria-labelledby="q-title">
    <div class="q-sheet">
      <header class="q-head">
        <div><span class="logo">AEROVANTIA<span>.</span></span><p class="q-meta" id="q-meta"></p></div>
        <button class="q-close" type="button" data-close aria-label="Cerrar">×</button>
      </header>
      <p class="eyebrow">Presupuesto orientativo</p>
      <h2 id="q-title"></h2>
      <div class="q-from"><span>Desde</span><b id="q-from"></b><small>IVA incluido</small></div>
      <table class="q-lines"><thead><tr><th>Concepto</th><th>Desde</th><th>Hasta</th></tr></thead><tbody id="q-lines"></tbody>
        <tfoot><tr><th>Total estimado</th><th id="q-lo"></th><th id="q-hi"></th></tr></tfoot></table>
      <ul class="q-notes" id="q-notes"></ul>
      <p class="q-legal">Presupuesto orientativo generado automáticamente a partir de los datos introducidos y de precios de mercado de 2026, IVA incluido. No es vinculante: el presupuesto definitivo con precio cerrado se entrega por escrito tras la visita técnica gratuita. Validez de la estimación: 30 días.</p>
      <div class="q-actions">
        <a class="btn btn-primary" href="#contacto" id="q-book">Reservar visita gratis</a>
        <button class="btn btn-ghost" type="button" id="q-pdf">Descargar PDF</button>
        <a class="btn btn-ghost" id="q-wa" target="_blank" rel="noopener">Enviar por WhatsApp</a>
      </div>
      <p class="q-company" id="q-company"></p>
    </div>
  </dialog>

  <section id="ayudas">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Ayudas</p><h2>Las ayudas las tramitamos nosotros.</h2><p class="lede">En el estudio te decimos qué ayudas aplican y las descontamos de la propuesta cuando es posible.</p></div>
      <div class="aid-grid">
        <div class="aid reveal"><div class="pct">40 %</div><h3>Deducción en el IRPF</h3><p>Base de hasta 7.500 € (máx. 3.000 €) si reduces un 30&nbsp;% el consumo no renovable o alcanzas calificación A o B. Plazo: 31 de diciembre de 2026.</p></div>
        <div class="aid reveal"><div class="pct">CAE</div><h3>Certificados de Ahorro Energético</h3><p>Al sustituir una caldera de combustión por aerotermia, el ahorro se convierte en un descuento directo. Depende de la zona climática.</p></div>
        <div class="aid reveal"><div class="pct">IBI · ICIO</div><h3>Bonificaciones municipales</h3><p>Muchos ayuntamientos bonifican el IBI o el impuesto de obras por instalar energía solar. Revisamos tu municipio.</p></div>
      </div>
    </div>
  </section>

  <section id="proceso">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Cómo trabajamos</p><h2>Simple para ti. Milimétrico por detrás.</h2></div>
      <div class="steps">
        <div class="step"><h3>Visita técnica</h3><p class="when">En 48 h</p><p>Revisamos la casa, las instalaciones y tus facturas.</p></div>
        <div class="step"><h3>Propuesta cerrada</h3><p class="when">En 5–10 días</p><p>Diseño, precio final, plazos y ayudas, por escrito. En reformas, con render 3D.</p></div>
        <div class="step"><h3>Obra</h3><p class="when">Según proyecto</p><p>Un único responsable coordina todos los gremios.</p></div>
        <div class="step"><h3>Legalización y ayudas</h3><p class="when">Incluido</p><p>Certificados, boletines, licencias y expediente de ayudas.</p></div>
        <div class="step"><h3>Care+</h3><p class="when">Opcional</p><p>Mantenimiento anual y seguimiento del rendimiento.</p></div>
      </div>
    </div>
  </section>

  <section class="guar calc">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Compromisos</p><h2>Desde 2019, lo que firmamos contigo.</h2></div>
      <div class="guar-grid">
        <div><h3>Precio cerrado</h3><p>El precio de la propuesta es el que pagas. Sin extras al terminar.</p></div>
        <div><h3>Un único interlocutor</h3><p>Un responsable de proyecto de la visita a la entrega de llaves.</p></div>
        <div><h3>Profesionales habilitados</h3><p>Carnet RITE, gases fluorados y seguro de responsabilidad civil.</p></div>
        <div><h3>Doble garantía</h3><p>Garantía del fabricante y garantía propia sobre la instalación y la obra.</p></div>
      </div>
    </div>
  </section>

  <section id="zona">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Zona de trabajo</p><h2>Reformas y aerotermia en Toledo y Madrid.</h2><p class="lede">Con oficina en Olías del Rey (Toledo), trabajamos en toda la provincia de Toledo, La Sagra y la Comunidad de Madrid. Si tu municipio no aparece, pregúntanos.</p></div>
      <div class="zones">
        <div><h3>Comunidad de Madrid</h3><ul><li>Boadilla del Monte</li><li>Villaviciosa de Odón</li><li>Villanueva de la Cañada</li><li>Brunete</li><li>Alcorcón</li><li>Móstoles</li><li>Arroyomolinos</li><li>Navalcarnero</li><li>Fuenlabrada</li><li>Getafe</li><li>Leganés</li><li>Parla</li><li>Griñón</li><li>Valdemoro</li></ul></div>
        <div><h3>Toledo y La Sagra</h3><ul><li>Seseña</li><li>Illescas</li><li>Yeles</li><li>Esquivias</li><li>Ugena</li><li>Yuncos</li><li>Numancia de la Sagra</li><li>Cabañas de la Sagra</li><li>Bargas</li><li>Olías del Rey</li><li>Toledo</li><li>Torrijos</li></ul></div>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que nos preguntan antes de decidir.</h2></div>
      <div class="faq">
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
    </div>
  </section>

  <section id="contacto">
    <div class="wrap contact-grid">
      <div>
        <div class="sec-head" style="margin:0"><p class="eyebrow">Estudio gratuito</p><h2>Pide tu estudio gratuito.</h2><p class="lede">Déjanos tus datos y te llamamos en menos de 24 h laborables para concertar la visita. O, si lo prefieres, llámanos ahora al <a href={`tel:${company.phones[0].tel}`}>{company.phones[0].display}</a>.</p></div>
        <div class="contact-points">
          <div><span class="k">Teléfonos</span><span class="v">{company.phones.map((p, i) => <>{i > 0 && " · "}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</span></div>
          <div><span class="k">WhatsApp</span><span class="v"><a href={whatsapp.href} target="_blank" rel="noopener">{whatsapp.display}</a></span></div>
          <div><span class="k">Email</span><span class="v"><a href={`mailto:${company.email}`}>{company.email}</a></span></div>
          <div><span class="k">Oficina</span><span class="v">{company.address}</span></div>
        </div>
      </div>
      <form class="lead" id="leadForm" novalidate>
        <p class="calc-note" id="f-calc" hidden></p>
        <div class="two">
          <div class="field"><label for="f-name">Nombre</label><input type="text" id="f-name" autocomplete="name" required></div>
          <div class="field"><label for="f-phone">Teléfono</label><input type="tel" id="f-phone" autocomplete="tel" inputmode="tel" required></div>
        </div>
        <div class="field"><label for="f-town">Municipio</label><input type="text" id="f-town" autocomplete="address-level2" required></div>
        <fieldset>
          <legend style="font-size:.88rem;font-weight:600">Me interesa</legend>
          <div class="pills">
            <label><input type="checkbox" id="i-ref"> Reforma</label>
            <label><input type="checkbox" id="i-new"> Obra nueva</label>
            <label><input type="checkbox" id="i-int"> Interiorismo</label>
            <label><input type="checkbox" id="i-aero"> Aerotermia</label>
            <label><input type="checkbox" id="i-pv"> Placas solares</label>
            <label><input type="checkbox" id="i-bat"> Batería</label>
            <label><input type="checkbox" id="i-ev"> Cargador VE</label>
          </div>
        </fieldset>
        <label class="chk" for="f-rgpd"><input type="checkbox" id="f-rgpd" required> <span>He leído la <a href="/privacidad/">política de privacidad</a> y acepto que Aerovantia me contacte para preparar el estudio.</span></label>
        <p class="err" id="f-err" hidden></p>
        <button class="btn btn-primary" type="submit">Solicitar estudio gratuito</button>
        <div class="ok-msg" id="f-ok" hidden></div>
      </form>
    </div>
  </section>
</main>
</Layout>

<script>
  import "../scripts/site.js";
</script>
