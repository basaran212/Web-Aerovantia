---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";

import Calculators from "../components/Calculators.astro";
import ScrollWorld from "../components/ScrollWorld.astro";
import config from "../data/config.json";
import { homeFaqs as faqs } from "../data/faqs";
import { municipios } from "../data/municipios";
import { projectHref, projects } from "../data/proyectos";
import { areas, company, whatsapp } from "../data/site";
import exteriorNoon from "../assets/img/exterior-noon.jpg";
import kitchenBefore from "../assets/img/kitchen-before.jpg";
import kitchen from "../assets/img/kitchen.jpg";
import living from "../assets/img/living.jpg";
import matBrass from "../assets/img/mat-brass.jpg";
import matMarble from "../assets/img/mat-marble.jpg";
import matMicro from "../assets/img/mat-micro.jpg";
import matOak from "../assets/img/mat-oak.jpg";
import matTrav from "../assets/img/mat-trav.jpg";
import newbuild from "../assets/img/newbuild.jpg";

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const statement = "Tu vivienda puede ser mucho más.";

const pillars = [
  { k: "Diseño", title: "Espacios pensados para tu forma de vivir.", text: "Distribución, materiales, luz y mobiliario a medida. Ves tu casa terminada en 3D antes de empezar.", img: living, alt: "Recreación ilustrativa con IA: salón con sofá de lino, mesa de travertino y luz cálida de tarde", href: "/interiorismo/", link: "Interiorismo" },
  { k: "Construcción", title: "Cada detalle importa.", text: "Reformas integrales y obra nueva con un responsable de proyecto y una red de empresas y profesionales especializados.", img: newbuild, alt: "Recreación ilustrativa con IA: estructura de un chalet en construcción", href: "/obra-nueva/", link: "Construcción" },
  { k: "Eficiencia", title: "La mejor tecnología es la que mejora tu vida sin hacerse notar.", text: "Aerotermia, energía solar y climatización integradas en la casa, calculadas con tus facturas.", img: exteriorNoon, alt: "Recreación ilustrativa con IA: chalet con placas solares en la cubierta a mediodía", href: "/eficiencia-energetica/", link: "Eficiencia energética" },
];

const tech = [
  { k: "Aerotermia", title: "Calor y frío del aire", text: "Calefacción, aire acondicionado y agua caliente con un solo equipo, sin combustión ni humos.", href: "/aerotermia/" },
  { k: "Energía solar", title: "Tu tejado trabaja", text: "Las placas cubren parte del consumo de la casa y, con batería, también por la tarde.", href: "/placas-solares/" },
  { k: "Climatización inteligente", title: "La casa a la temperatura justa", text: "Suelo radiante, control por estancias y agua caliente en las horas de sol.", href: "/aerotermia-y-placas-solares/" },
  { k: "Aislamiento", title: "La energía que no se escapa", text: "Si reformas, mejoramos ventanas y aislamiento para que la casa necesite menos.", href: "/reformas/" },
];

const materials = [
  { img: matMarble, name: "Mármol Calacatta", use: "Encimeras y baños", alt: "Recreación ilustrativa con IA: textura de mármol Calacatta" },
  { img: matOak, name: "Roble natural", use: "Suelos y carpintería", alt: "Recreación ilustrativa con IA: textura de roble natural" },
  { img: matTrav, name: "Travertino", use: "Paredes y escaleras", alt: "Recreación ilustrativa con IA: textura de travertino" },
  { img: matMicro, name: "Microcemento", use: "Continuidad sin juntas", alt: "Recreación ilustrativa con IA: textura de microcemento" },
  { img: matBrass, name: "Latón cepillado", use: "Grifería y detalles", alt: "Recreación ilustrativa con IA: textura de latón cepillado" },
];

const method = [
  { title: "Estudio", text: "Visitamos tu casa o tu parcela, revisamos facturas e instalaciones y escuchamos qué necesitas." },
  { title: "Diseño y planificación", text: "Distribución, materiales y sistemas energéticos, con renders cuando el proyecto lo pide." },
  { title: "Presupuesto detallado", text: "Propuesta por escrito con partidas desglosadas, plazos y las ayudas que te aplican." },
  { title: "Coordinación de profesionales", text: "Organizamos a las empresas y profesionales especializados de nuestra red, cada uno en su fase." },
  { title: "Ejecución supervisada", text: "Tu responsable de proyecto supervisa la obra y te informa en cada hito." },
  { title: "Entrega y seguimiento", text: "Puesta en marcha, legalización, documentación y seguimiento después de la entrega." },
];

const pc = config.primerosClientes;
const landing = (name: string) => municipios.find((m) => m.name === name);
---

<Layout schema={schema} darkTop>
<main>
  <ScrollWorld />

  <section class="manifesto" id="manifiesto" aria-label="Manifiesto">
    <div class="wrap">
      <p class="statement" data-words>{statement.split(" ").map((w) => <><span data-word>{w}</span>{" "}</>)}</p>
      <p class="sub reveal">Más diseño. Más confort. Más eficiencia. Una forma diferente de construir y transformar espacios.</p>
    </div>
  </section>

  <section id="servicios" style="padding-top:0">
    <div class="wrap pillars">
      {pillars.map((p) => (
        <article class="pillar reveal">
          <div class="pillar-media">
            <Picture src={p.img} alt={p.alt} formats={["avif", "webp"]} widths={[640, 960, 1440]} sizes="(min-width: 900px) 56vw, 100vw" loading="lazy" decoding="async" />
            <span class="ai-tag">Imagen ilustrativa generada con IA</span>
          </div>
          <div class="pillar-text">
            <p class="eyebrow">{p.k}</p>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a class="text-link" href={p.href}>{p.link} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="feature" id="reformas" aria-label="Reformas integrales">
    <Picture src={kitchen} alt="Recreación ilustrativa con IA: cocina con isla de mármol, roble natural y lámparas de latón" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="100vw" loading="lazy" decoding="async" />
    <span class="ai-tag">Imagen ilustrativa generada con IA</span>
    <div class="wrap">
      <p class="eyebrow">Reformas integrales</p>
      <h2>Transformamos espacios. Elevamos tu manera de vivir.</h2>
      <p>Reformas integrales de viviendas, cocinas y baños con un solo responsable, bajo proyecto. Y, ya que abrimos suelos y paredes, dejamos la casa lista para gastar menos energía.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/reformas/">Ver reformas integrales</a>
        <a class="btn btn-ghost" href="/calculadoras/reformas/">Calcular mi reforma</a>
      </div>
    </div>
  </section>

  <section class="after-feature" aria-label="Antes y después">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Antes y después</p>
        <h2>De casa anticuada a casa eficiente.</h2>
        <p class="lede">Recreación del tipo de transformación que proyectamos. Desliza para comparar.</p>
      </div>
      <div class="ref-grid">
        <div class="ba reveal" data-ba>
          <Picture src={kitchen} alt="Recreación ilustrativa con IA: cocina reformada con isla de mármol y roble" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" />
          <Picture src={kitchenBefore} alt="Recreación ilustrativa con IA: cocina de los años noventa antes de reformar" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" class="before" />
          <span class="handle" aria-hidden="true"></span>
          <span class="lbl l">Antes</span><span class="lbl r">Después</span>
          <span class="ai-tag">Imagen ilustrativa generada con IA</span>
          <input type="range" min="0" max="100" value="50" aria-label="Deslizar entre antes y después de la recreación" />
        </div>
        <div class="ref-points">
          <div><h3>Reforma integral</h3><p>Distribución, instalaciones, carpintería y acabados, bajo proyecto y con un único responsable.</p></div>
          <div><h3>Cocinas y baños</h3><p>Piedra natural, duchas a ras de suelo y grifería termostática, con el agua caliente de la aerotermia.</p></div>
          <div><h3>Interiorismo</h3><p>Proyecto 3D, selección de materiales, iluminación y mobiliario a medida. <a href="/interiorismo/">Ver interiorismo</a>.</p></div>
          <div><h3>Energía integrada</h3><p>Suelo radiante, aerotermia y preinstalación de placas. <a href="/reformas/">Ver reformas</a>.</p></div>
        </div>
      </div>
      <div class="swatches" aria-label="Materiales">
        {materials.map((m) => (
          <div class="sw reveal">
            <div class="ai-wrap">
              <Picture src={m.img} alt={m.alt} formats={["avif", "webp"]} widths={[320, 480]} sizes="(min-width: 640px) 20vw, 50vw" loading="lazy" decoding="async" />
              <span class="ai-tag">IA</span>
            </div>
            <span><b>{m.name}</b>{m.use}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="tecnologia" class="calc" aria-label="Tecnología">
    <div class="wrap">
      <div class="sec-head tech-head reveal">
        <p class="eyebrow">Eficiencia energética</p>
        <h2>El confort que sientes. La tecnología que no ves.</h2>
        <p class="lede">Primero, una casa a la temperatura justa todo el año. Después, los equipos que lo hacen posible, escondidos en la obra.</p>
      </div>
      <div class="tech-grid">
        {tech.map((t) => (
          <div class="tech-item reveal">
            <span class="k">{t.k}</span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <a class="text-link" href={t.href}>Saber más <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </div>
      <div class="deadline" style="margin-top:72px;border-radius:var(--r-xl)">
        <div class="wrap" style="padding-inline:24px">
          <div class="date">Hasta 31.12.2026</div>
          <p><strong>Deducción del 40&nbsp;% en el IRPF</strong>, si la instalación reduce al menos un 30&nbsp;% el consumo de energía no renovable o la vivienda llega a calificación A o B. Hace falta certificado energético antes y después. También revisamos los <a href="/ayudas/cae/">CAE</a> y las <a href="/ayudas/bonificacion-ibi-icio/">bonificaciones de IBI e ICIO</a>.</p>
          <a class="btn btn-ghost" href="/ayudas/deduccion-irpf/">Ver requisitos</a>
        </div>
      </div>
    </div>
  </section>

  <section id="calculadoras" aria-label="Configura tu proyecto">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Configura tu proyecto</p>
        <h2>Unas preguntas. Un rango claro.</h2>
        <p class="lede">Responde paso a paso y verás un rango orientativo con IVA y las hipótesis a la vista. El precio de tu proyecto es el de la propuesta por escrito. <a href="/calculadoras/">Todas las calculadoras</a>.</p>
      </div>
      <Calculators />
    </div>
  </section>

  <section id="proceso" class="calc" aria-label="Nuestro método">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Nuestro método</p>
        <h2>Una dirección. Muchos especialistas.</h2>
        <p class="lede">Aerovantia coordina cada proyecto con supervisión técnica y una red de empresas y profesionales especializados. Tienes un único responsable, que responde del proyecto según lo que firmamos.</p>
      </div>
      <ol class="method" style="padding:0;margin:0">
        {method.map((m) => <li class="reveal"><h3>{m.title}</h3><p>{m.text}</p></li>)}
      </ol>
      <div class="guar-grid" style="margin-top:72px">
        <div><h3>Precio fijado en la propuesta</h3><p>El precio de la instalación queda fijado en la propuesta que firmas. Cualquier cambio se aprueba por escrito.</p></div>
        <div><h3>Un único interlocutor</h3><p>Un responsable de proyecto desde la visita hasta la puesta en marcha.</p></div>
        <div><h3>Instaladores habilitados</h3><p>Instalación realizada por instaladores habilitados RITE y gases fluorados.</p></div>
        <div><h3>Garantías</h3><p>La garantía del fabricante del equipo y la garantía legal de la instalación{config.garantiaPropia ? `, más ${config.garantiaPropia}` : ""}.</p></div>
      </div>
      <p class="method-note"><a class="text-link" href="/como-trabajamos/">Cómo trabajamos, en detalle <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section id="proyectos" aria-label="Proyectos">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Proyectos</p>
        <h2>Ideas que proyectamos.</h2>
        <p class="lede">Somos una marca nueva: estas son visualizaciones conceptuales, no obras realizadas. Las primeras obras llegarán con el programa <a href="/primeros-clientes/">Primeros clientes</a>.</p>
      </div>
      <div class="proj-grid three">
        {projects.map((p) => (
          <a class="proj reveal" href={projectHref(p)}>
            <div class="proj-media">
              <Picture src={p.cover} alt={p.coverAlt} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 1100px) 33vw, (min-width: 768px) 50vw, 100vw" loading="lazy" decoding="async" />
              <span class="ai-tag">Visualización conceptual · IA</span>
            </div>
            <span class="type">Visualización conceptual</span>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
      <p class="method-note"><a class="text-link" href="/proyectos/">Ver todos los proyectos <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="cta-band" id="primeros-clientes">
    <div class="wrap">
      <div class="sec-head" style="margin:0">
        <p class="eyebrow">Programa Primeros clientes</p>
        <h2>Las primeras obras, con condiciones especiales.</h2>
        <p>{pc.condicion} para las primeras {pc.plazasTotales} instalaciones, a cambio de permiso para fotografiar la obra y de tu opinión cuando esté en marcha. Plazas disponibles: {pc.plazasDisponibles}.</p>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/primeros-clientes/">Ver condiciones</a>
      </div>
    </div>
  </section>

  <section id="zona">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Zona de trabajo</p><h2>Madrid y Toledo.</h2><p class="lede">Con oficina en Olías del Rey (Toledo), trabajamos en la Comunidad de Madrid y en la provincia de Toledo. Si tu municipio no aparece, pregúntanos.</p></div>
      <div class="zones">
        {Object.entries(areas).map(([name, towns], i) => (
          <div>
            <h3><a href={i === 0 ? "/zona/madrid/" : "/zona/toledo/"}>{name}</a></h3>
            <ul>{towns.map((t) => { const m = landing(t); return <li>{m ? <a href={m.href}>{t}</a> : t}</li>; })}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="calc">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que nos preguntan antes de decidir.</h2></div>
      <div class="faq">
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
    </div>
  </section>

  <section id="contacto" class="closing">
    <div class="wrap contact-grid">
      <div>
        <div class="sec-head" style="margin:0"><p class="eyebrow">Contacto</p><h2>Tu próximo espacio empieza con una conversación.</h2><p class="lede">Cuéntanos tu proyecto y te llamamos en menos de 24 h laborables para concertar la visita. O llámanos al <a href={`tel:${company.phones[0].tel}`}>{company.phones[0].display}</a>.</p></div>
        <div class="contact-points">
          <div><span class="k">Teléfonos</span><span class="v">{company.phones.map((p, i) => <>{i > 0 && " · "}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</span></div>
          <div><span class="k">WhatsApp</span><span class="v"><a href={whatsapp.href} target="_blank" rel="noopener">{whatsapp.display}</a></span></div>
          <div><span class="k">Email</span><span class="v"><a href={`mailto:${company.email}`}>{company.email}</a></span></div>
          <div><span class="k">Oficina</span><span class="v">{company.address}</span></div>
        </div>
      </div>
      <form class="lead" id="leadForm" novalidate>
        <p class="calc-note" id="f-calc" hidden></p>
        <div class="two">
          <div class="field"><label for="f-name">Nombre</label><input type="text" id="f-name" autocomplete="name" required></div>
          <div class="field"><label for="f-phone">Teléfono</label><input type="tel" id="f-phone" autocomplete="tel" inputmode="tel" required></div>
        </div>
        <div class="two">
          <div class="field"><label for="f-type">Tipo de proyecto</label>
            <select id="f-type" required>
              <option value="">Elige una opción</option>
              <option>Reforma integral</option>
              <option>Cocina o baño</option>
              <option>Obra nueva</option>
              <option>Aerotermia</option>
              <option>Placas solares</option>
              <option>Aerotermia + Solar</option>
              <option>Cargador de coche eléctrico</option>
              <option>Interiorismo</option>
              <option>Otro</option>
            </select></div>
          <div class="field"><label for="f-town">Ubicación (municipio)</label><input type="text" id="f-town" autocomplete="address-level2" required></div>
        </div>
        <div class="two">
          <div class="field"><label for="f-m2">Superficie aproximada</label>
            <select id="f-m2"><option value="">Prefiero no decirlo</option><option>Menos de 80 m²</option><option>80–150 m²</option><option>150–250 m²</option><option>250–400 m²</option><option>Más de 400 m²</option></select></div>
          <div class="field"><label for="f-budget">Presupuesto estimado</label>
            <select id="f-budget"><option value="">Aún no lo sé</option><option>Menos de 15.000 €</option><option>15.000–50.000 €</option><option>50.000–150.000 €</option><option>150.000–400.000 €</option><option>Más de 400.000 €</option></select></div>
        </div>
        <div class="field"><label for="f-when">¿Cuándo te gustaría empezar?</label>
          <select id="f-when"><option value="">Aún no lo sé</option><option>Lo antes posible</option><option>En los próximos 3 meses</option><option>En los próximos 6 meses</option><option>En 2027</option><option>Solo me estoy informando</option></select></div>
        <label class="chk" for="i-first"><input type="checkbox" id="i-first"> <span>Quiero ser de los primeros clientes (<a href="/primeros-clientes/">condiciones</a>).</span></label>
        <label class="chk" for="f-rgpd"><input type="checkbox" id="f-rgpd" required> <span>He leído la <a href="/privacidad/">política de privacidad</a> y acepto que Aerovantia me contacte para preparar el estudio.</span></label>
        <label class="chk" for="f-mkt"><input type="checkbox" id="f-mkt"> <span>Quiero recibir información comercial de Aerovantia (opcional).</span></label>
        <p class="err" id="f-err" hidden></p>
        <button class="btn btn-primary" type="submit">Hablemos de tu proyecto</button>
        <div class="ok-msg" id="f-ok" hidden></div>
      </form>
    </div>
  </section>
</main>
</Layout>

<script>
  import "../scripts/form.js";
</script>
