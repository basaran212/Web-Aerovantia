---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";

import Calculators from "../components/Calculators.astro";
import ScrollWorld from "../components/ScrollWorld.astro";
import config from "../data/config.json";
import { homeFaqs as faqs } from "../data/faqs";
import { municipios } from "../data/municipios";
import { areas, company, whatsapp } from "../data/site";
import exteriorNoon from "../assets/img/exterior-noon.jpg";
import heatpump from "../assets/img/heatpump.jpg";
import kitchenBefore from "../assets/img/kitchen-before.jpg";
import kitchen from "../assets/img/kitchen.jpg";
import living from "../assets/img/living.jpg";
import matBrass from "../assets/img/mat-brass.jpg";
import matMarble from "../assets/img/mat-marble.jpg";
import matMicro from "../assets/img/mat-micro.jpg";
import matOak from "../assets/img/mat-oak.jpg";
import matTrav from "../assets/img/mat-trav.jpg";
import solarRoof from "../assets/img/solar-roof.jpg";

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const tagline = "Aerotermia y placas solares estudiadas con tus facturas. Una propuesta por escrito, las ayudas explicadas y un solo responsable.";

const services = [
  { href: "/aerotermia/", tag: "Aerotermia", title: "Calefacción, frío y agua caliente", text: "Bomba de calor que sustituye tu caldera. Ahorro estimado según el sistema que tengas hoy.", img: heatpump, alt: "Recreación ilustrativa con IA: unidad exterior de aerotermia junto a la fachada blanca de una casa" },
  { href: "/placas-solares/", tag: "Placas solares", title: "Produce tu propia energía", text: "Paneles, batería y cargador del coche, calculados con tu consumo real.", img: solarRoof, alt: "Recreación ilustrativa con IA: vista aérea de una cubierta con placas solares y piscina" },
  { href: "/aerotermia-y-placas-solares/", tag: "Aerotermia + Solar", title: "La casa que calienta con su tejado", text: "Las dos calculadas juntas, con el consumo que tendrás después.", img: exteriorNoon, alt: "Recreación ilustrativa con IA: chalet con placas solares en la cubierta a mediodía" },
  { href: "/reformas/", tag: "Reformas con energía", title: "Reforma con la energía integrada", text: "Cocinas, baños y reformas integrales con aerotermia y suelo radiante, bajo proyecto.", img: kitchen, alt: "Recreación ilustrativa con IA: cocina con isla de mármol, madera de roble y lámparas de latón" },
  { href: "/interiorismo/", tag: "Interiorismo", title: "Diseño interior con proyecto 3D", text: "Distribución, materiales, iluminación y mobiliario a medida.", img: living, alt: "Recreación ilustrativa con IA: salón con sofá de lino, mesa de travertino y luz cálida de tarde" },
];

const materials = [
  { img: matMarble, name: "Mármol Calacatta", use: "Encimeras y baños", alt: "Recreación ilustrativa con IA: textura de mármol Calacatta" },
  { img: matOak, name: "Roble natural", use: "Suelos y carpintería", alt: "Recreación ilustrativa con IA: textura de roble natural" },
  { img: matTrav, name: "Travertino", use: "Paredes y escaleras", alt: "Recreación ilustrativa con IA: textura de travertino" },
  { img: matMicro, name: "Microcemento", use: "Continuidad sin juntas", alt: "Recreación ilustrativa con IA: textura de microcemento" },
  { img: matBrass, name: "Latón cepillado", use: "Grifería y detalles", alt: "Recreación ilustrativa con IA: textura de latón cepillado" },
];

const pc = config.primerosClientes;
const landing = (name: string) => municipios.find((m) => m.name === name);
---

<Layout schema={schema}>
<main>
  <ScrollWorld />

  <div class="deadline">
    <div class="wrap">
      <div class="date">Hasta 31.12.2026</div>
      <p><strong>Deducción del 40&nbsp;% en el IRPF</strong>, si la instalación reduce al menos un 30&nbsp;% el consumo de energía no renovable o la vivienda llega a calificación A o B. Hace falta certificado energético antes y después.</p>
      <a class="btn btn-ghost" href="/ayudas/deduccion-irpf/">Ver requisitos</a>
    </div>
  </div>

  <section class="tagline" aria-label="Lo que hacemos">
    <div class="wrap">
      <p data-words>{tagline.split(" ").map((w) => <><span data-word>{w}</span>{" "}</>)}</p>
    </div>
  </section>

  <section id="servicios" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Qué hacemos</p>
        <h2>Aerotermia, placas solares y reformas con la energía integrada.</h2>
        <p class="lede">Estudio, propuesta, diseño y ayudas, con un único responsable. La instalación la realizan instaladores habilitados RITE y gases fluorados.</p>
      </div>
      <div class="bento">
        {services.map((s, i) => (
          <a class="tile reveal" href={s.href}>
            <Picture src={s.img} alt={s.alt} formats={["avif", "webp"]} widths={[640, 960, 1440]} sizes={i === 0 ? "(min-width: 768px) 66vw, 100vw" : "(min-width: 768px) 33vw, 100vw"} loading="lazy" decoding="async" />
            <span class="ai-tag">Imagen ilustrativa generada con IA</span>
            <div class="body">
              <span class="tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="more">Ver {s.tag.toLowerCase()} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="reformas" class="calc">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Reformas con energía e interiorismo</p>
        <h2>De casa anticuada a casa eficiente.</h2>
        <p class="lede">Recreación del tipo de transformación que proyectamos. Si reformas, quitamos radiadores y caldera, metemos suelo radiante bajo la madera y dejamos la casa lista para producir su propia energía.</p>
      </div>
      <div class="ref-grid">
        <div class="ba reveal" data-ba>
          <Picture src={kitchen} alt="Recreación ilustrativa con IA: cocina reformada con isla de mármol y roble" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" />
          <Picture src={kitchenBefore} alt="Recreación ilustrativa con IA: cocina de los años noventa antes de reformar" formats={["avif", "webp"]} widths={[828, 1280, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" loading="lazy" decoding="async" class="before" />
          <span class="handle" aria-hidden="true"></span>
          <span class="lbl l">Antes</span><span class="lbl r">Después</span>
          <span class="ai-tag">Imagen ilustrativa generada con IA</span>
          <input type="range" min="0" max="100" value="50" aria-label="Deslizar entre antes y después de la recreación" />
        </div>
        <div class="ref-points">
          <div><h3>Reforma integral</h3><p>Distribución, instalaciones, carpintería y acabados, bajo proyecto y con un único responsable.</p></div>
          <div><h3>Cocinas y baños</h3><p>Islas de piedra natural, duchas a ras de suelo y grifería termostática, con el agua caliente de la aerotermia.</p></div>
          <div><h3>Interiorismo</h3><p>Proyecto 3D, selección de materiales, iluminación y mobiliario a medida. <a href="/interiorismo/">Ver interiorismo</a>.</p></div>
          <div><h3>Energía integrada</h3><p>Suelo radiante, aerotermia y preinstalación de placas: confort sin radiadores y menos factura. <a href="/reformas/">Ver reformas</a>.</p></div>
        </div>
      </div>
      <div class="swatches" aria-label="Materiales">
        {materials.map((m) => (
          <div class="sw reveal">
            <div class="ai-wrap">
              <Picture src={m.img} alt={m.alt} formats={["avif", "webp"]} widths={[320, 480]} sizes="(min-width: 640px) 20vw, 50vw" loading="lazy" decoding="async" />
              <span class="ai-tag">IA</span>
            </div>
            <span><b>{m.name}</b>{m.use}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="calculadoras">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Presupuesto orientativo</p>
        <h2>Calcula el precio de tu instalación en un minuto.</h2>
        <p class="lede">Rangos orientativos con IVA y con las hipótesis a la vista. Elige tu proyecto y ajusta los datos. <a href="/calculadoras/">Ver todas las calculadoras</a>.</p>
      </div>
      <Calculators />
    </div>
  </section>

  <section id="ayudas">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Ayudas</p><h2>Te decimos qué ayudas te aplican y las tramitamos.</h2><p class="lede">En el estudio revisamos los requisitos de tu caso. Si no cumples alguno, te lo decimos en la visita. <a href="/ayudas/">Ver todas las ayudas</a>.</p></div>
      <div class="aid-grid">
        <div class="aid reveal"><div class="pct">40 %</div><h3>Deducción en el IRPF</h3><p>Puedes aplicarla si cumples los requisitos: reducir un 30&nbsp;% el consumo no renovable o llegar a calificación A o B. Base máxima de 7.500 € (deducción de hasta 3.000 €). Hasta el 31-12-2026.</p><a class="more" href="/ayudas/deduccion-irpf/">Ver requisitos <span aria-hidden="true">→</span></a></div>
        <div class="aid reveal"><div class="pct">CAE</div><h3>Certificados de Ahorro Energético</h3><p>Al sustituir una caldera de combustión por aerotermia, el ahorro puede convertirse en un pago. El importe depende del ahorro acreditado.</p><a class="more" href="/ayudas/cae/">Ver cómo funcionan <span aria-hidden="true">→</span></a></div>
        <div class="aid reveal"><div class="pct">IBI · ICIO</div><h3>Bonificaciones municipales</h3><p>Algunos ayuntamientos bonifican el IBI o el impuesto de obras por instalar energía solar. Revisamos el tuyo.</p><a class="more" href="/ayudas/bonificacion-ibi-icio/">Ver bonificaciones <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section id="proceso">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Cómo trabajamos</p><h2>Simple para ti. Ordenado por detrás.</h2><p class="lede"><a href="/como-trabajamos/">Ver el proceso completo</a>.</p></div>
      <div class="steps">
        <div class="step"><h3>Te llamamos</h3><p class="when">En menos de 24 h laborables</p><p>Hablamos de tu casa y concertamos la visita.</p></div>
        <div class="step"><h3>Propuesta por escrito</h3><p class="when">5–10 días tras la visita</p><p>Equipos, partidas desglosadas, ahorro estimado y ayudas que te aplican.</p></div>
        <div class="step"><h3>Instalación</h3><p class="when">Según el calendario de la propuesta</p><p>Instaladores habilitados RITE y gases fluorados, coordinados por tu responsable de proyecto.</p></div>
        <div class="step"><h3>Legalización y ayudas</h3><p class="when">Incluido</p><p>Certificados, boletines, licencias y expediente de ayudas.</p></div>
        <div class="step"><h3>Puesta en marcha</h3><p class="when">Contigo</p><p>Revisamos el funcionamiento y te explicamos el mantenimiento.</p></div>
      </div>
    </div>
  </section>

  <section class="guar calc">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Compromisos</p><h2>Lo que firmamos contigo.</h2></div>
      <div class="guar-grid">
        <div><h3>Precio fijado en la propuesta</h3><p>El precio de la instalación queda fijado en la propuesta que firmas. Cualquier cambio se aprueba por escrito.</p></div>
        <div><h3>Un único interlocutor</h3><p>Un responsable de proyecto desde la visita hasta la puesta en marcha.</p></div>
        <div><h3>Instaladores habilitados</h3><p>Instalación realizada por instaladores habilitados RITE y gases fluorados.</p></div>
        <div><h3>Garantías</h3><p>La garantía del fabricante del equipo y la garantía legal de la instalación{config.garantiaPropia ? `, más ${config.garantiaPropia}` : ""}.</p></div>
      </div>
    </div>
  </section>

  <section id="zona">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Zona de trabajo</p><h2>Aerotermia y placas solares en Madrid y Toledo.</h2><p class="lede">Con oficina en Olías del Rey (Toledo), trabajamos en la Comunidad de Madrid y en la provincia de Toledo. Si tu municipio no aparece, pregúntanos.</p></div>
      <div class="zones">
        {Object.entries(areas).map(([name, towns], i) => (
          <div>
            <h3><a href={i === 0 ? "/zona/madrid/" : "/zona/toledo/"}>{name}</a></h3>
            <ul>{towns.map((t) => { const m = landing(t); return <li>{m ? <a href={m.href}>{t}</a> : t}</li>; })}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que nos preguntan antes de decidir.</h2></div>
      <div class="faq">
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
    </div>
  </section>

  <section class="cta-band" id="primeros-clientes">
    <div class="wrap">
      <div class="sec-head" style="margin:0">
        <p class="eyebrow">Programa Primeros clientes</p>
        <h2>Las primeras instalaciones, con condiciones especiales.</h2>
        <p>{pc.condicion} para las primeras {pc.plazasTotales} instalaciones, a cambio de permiso para fotografiar la obra y de tu opinión cuando esté en marcha. Plazas disponibles: {pc.plazasDisponibles}.</p>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/primeros-clientes/">Ver condiciones</a>
      </div>
    </div>
  </section>

  <section id="contacto">
    <div class="wrap contact-grid">
      <div>
        <div class="sec-head" style="margin:0"><p class="eyebrow">Estudio gratuito</p><h2>Pide tu estudio gratuito.</h2><p class="lede">Déjanos tus datos y te llamamos en menos de 24 h laborables para concertar la visita. O, si lo prefieres, llámanos ahora al <a href={`tel:${company.phones[0].tel}`}>{company.phones[0].display}</a>.</p></div>
        <div class="contact-points">
          <div><span class="k">Teléfonos</span><span class="v">{company.phones.map((p, i) => <>{i > 0 && " · "}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</span></div>
          <div><span class="k">WhatsApp</span><span class="v"><a href={whatsapp.href} target="_blank" rel="noopener">{whatsapp.display}</a></span></div>
          <div><span class="k">Email</span><span class="v"><a href={`mailto:${company.email}`}>{company.email}</a></span></div>
          <div><span class="k">Oficina</span><span class="v">{company.address}</span></div>
        </div>
      </div>
      <form class="lead" id="leadForm" novalidate>
        <p class="calc-note" id="f-calc" hidden></p>
        <div class="two">
          <div class="field"><label for="f-name">Nombre</label><input type="text" id="f-name" autocomplete="name" required></div>
          <div class="field"><label for="f-phone">Teléfono</label><input type="tel" id="f-phone" autocomplete="tel" inputmode="tel" required></div>
        </div>
        <div class="field"><label for="f-town">Municipio</label><input type="text" id="f-town" autocomplete="address-level2" required></div>
        <fieldset>
          <legend style="font-size:.88rem;font-weight:600">Me interesa</legend>
          <div class="pills">
            <label><input type="checkbox" id="i-aero"> Aerotermia</label>
            <label><input type="checkbox" id="i-pv"> Placas solares</label>
            <label><input type="checkbox" id="i-combo"> Aerotermia + Solar</label>
            <label><input type="checkbox" id="i-bat"> Batería</label>
            <label><input type="checkbox" id="i-ev"> Cargador VE</label>
            <label><input type="checkbox" id="i-ref"> Reforma</label>
            <label><input type="checkbox" id="i-new"> Obra nueva</label>
            <label><input type="checkbox" id="i-int"> Interiorismo</label>
            <label><input type="checkbox" id="i-first"> Primeros clientes</label>
          </div>
        </fieldset>
        <label class="chk" for="f-rgpd"><input type="checkbox" id="f-rgpd" required> <span>He leído la <a href="/privacidad/">política de privacidad</a> y acepto que Aerovantia me contacte para preparar el estudio.</span></label>
        <label class="chk" for="f-mkt"><input type="checkbox" id="f-mkt"> <span>Quiero recibir información comercial de Aerovantia (opcional).</span></label>
        <p class="err" id="f-err" hidden></p>
        <button class="btn btn-primary" type="submit">Solicitar estudio gratuito</button>
        <div class="ok-msg" id="f-ok" hidden></div>
      </form>
    </div>
  </section>
</main>
</Layout>

<script>
  import "../scripts/form.js";
</script>
